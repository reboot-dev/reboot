workspace(name = "com_github_reboot_dev_reboot")

########################################################################

# We pull in the following repositories as local repositories pointing to their
# git submodules that we have so that we can do do more efficient development
# between the two repositories.

local_repository(
    name = "com_github_3rdparty_stout",
    path = "submodules/stout",
)

local_repository(
    name = "com_github_reboot_dev_pyprotoc_plugin",
    path = "submodules/pyprotoc-plugin",
)

########################################################################

load("//bazel:repos.bzl", "repos")

repos()

load("//bazel:py_toolchains.bzl", reboot_py_toolchains = "py_toolchains")

reboot_py_toolchains()

load("//bazel:pypi_repos.bzl", reboot_pypi_repos = "pypi_repos")

reboot_pypi_repos()

########################################################################

load("//bazel:deps.bzl", "deps")

deps()

########################################################################
# Create the host platform repository required by aspect_bazel_lib 2.x.

load("@bazel_tools//tools/build_defs/repo:utils.bzl", "maybe")
load("@platforms//host:extension.bzl", "host_platform_repo")

maybe(
    host_platform_repo,
    name = "host_platform",
)

########################################################################

load("//bazel:extra_deps.bzl", "extra_deps")

extra_deps()

########################################################################

load("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

########################################################################
# aspect_rules_ts setup, done here instead of splitting between
# 'bazel/repos.bzl' and 'bazel/deps.bzl' as this requires multiple
# "depths" of 'load(...)' calls. Ultimately it's time to move to Bazel
# modules as well.

http_archive(
    name = "aspect_rules_ts",
    sha256 = "b11f5bd59983a58826842029b99240fd0eeb6f1291d710db10f744b327701646",
    strip_prefix = "rules_ts-2.3.0",
    url = "https://github.com/aspect-build/rules_ts/releases/download/v2.3.0/rules_ts-v2.3.0.tar.gz",
)

load("@aspect_rules_ts//ts:repositories.bzl", "rules_ts_dependencies")

rules_ts_dependencies(
    # `rules_ts` 2.3.0 only ships hashes for TypeScript <= 5.4.5, so
    # name the integrity of the version `package.json` asks for.
    ts_integrity = "sha512-jl1vZzPDinLr9eUt3J/t7V6FgNEw9QjvBPdysz9KfQDD41fQrC2Y4vKQdiaUpFT4bXlb1RHhLpp8wtm6M5TgSw==",
    ts_version_from = "//:package.json",
)

load("@aspect_rules_js//js:repositories.bzl", "rules_js_dependencies")

rules_js_dependencies()

load("@bazel_features//:deps.bzl", "bazel_features_deps")

bazel_features_deps()

########################################################################

load("@rules_nodejs//nodejs:repositories.bzl", "nodejs_register_toolchains")

# The 'node_repositories' dict specifying Node.js v26.11.1 information comes
# from https://nodejs.org/dist/v26.11.1/SHASUMS256.txt, in the format of
# https://github.com/bazelbuild/rules_nodejs/blob/main/nodejs/private/node_versions.bzl
# We have to do this explicitly because the default Nodejs version is 16. We
# need a Nodejs version >=26.
# The name 'node' for this toolchain is important, since it's how we refer
# to it in several other Bazel files.
nodejs_register_toolchains(
    name = "node",
    node_repositories = {
        "26.11.1-darwin_amd64": ("node-v26.11.1-darwin-x64.tar.gz", "node-v26.11.1-darwin-x64", "9a8129bd9ab08039793dd1143a7aedee6b5d60ac06592ad938d8bddf36142f3a"),
        "26.11.1-darwin_arm64": ("node-v26.11.1-darwin-arm64.tar.gz", "node-v26.11.1-darwin-arm64", "d916511b55965e91be7a88e17f88d895b6793ceaba3e6c9b194aefe51c2c65ac"),
        "26.11.1-linux_amd64": ("node-v26.11.1-linux-x64.tar.xz", "node-v26.11.1-linux-x64", "3883bfc73f9a680ca4eab04b196068aaaab1373ffa77d8fc1a4408222495b651"),
        "26.11.1-linux_arm64": ("node-v26.11.1-linux-arm64.tar.xz", "node-v26.11.1-linux-arm64", "0945e2cde6aa0f54d980f03874dfe5cf3a549ce714c7fb9019e591ce0accf282"),
        "26.11.1-linux_ppc64le": ("node-v26.11.1-linux-ppc64le.tar.xz", "node-v26.11.1-linux-ppc64le", "96ee3114c4215fd986ac4e935dc6edb19990865f9f2dc4333b30d14050f96d22"),
        "26.11.1-linux_s390x": ("node-v26.11.1-linux-s390x.tar.xz", "node-v26.11.1-linux-s390x", "cabaa5fd10e805809f2a19661fb35a7055de444d584b346142412aa89ee55a51"),
        "26.11.1-windows_amd64": ("node-v26.11.1-win-x64.zip", "node-v26.11.1-win-x64", "97f36a8a9684ff0d3e35758b4610fef5b628a5880e96f2ccc11240e5daf9934e"),
    },
    node_version = "26.11.1",
)

load("@aspect_rules_js//npm:repositories.bzl", "npm_translate_lock")

npm_translate_lock(
    name = "npm",
    pnpm_lock = "//:pnpm-lock.yaml",
    verify_node_modules_ignored = "//:.bazelignore",
)

load("@npm//:repositories.bzl", "npm_repositories")

npm_repositories()

########################################################################

http_archive(
    name = "aspect_rules_esbuild",
    sha256 = "ce206c03e27a702ba2a480ee0a1e4f8db124f3595460a77a3ae1e465243c7a73",
    strip_prefix = "rules_esbuild-0.19.0",
    url = "https://github.com/aspect-build/rules_esbuild/releases/download/v0.19.0/rules_esbuild-v0.19.0.tar.gz",
)

