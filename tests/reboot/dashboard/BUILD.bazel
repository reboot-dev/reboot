# `api_reader.py` writes the state types and
# `link_fields_to_data_types.ts` walks them. This runs the real reader
# over the API files in this package so the test below walks real
# output the way the page does. The output is a TypeScript module so
# that it is a source of the test, with no file to read at runtime.
genrule(
    name = "state_types",
    srcs = glob(["api/**"]),
    outs = ["state_types.ts"],
    # Run from this package with a relative `api`, the way
    # `rbt dashboard --api-directory=api` does, so that each state
    # type's `file` is `api/shop/v1/shop.py` as in a real dashboard.
    cmd = "OUT=$$PWD/$@ && " +
          "READER=$$PWD/$(location //reboot/dashboard:api_reader) && " +
          "cd $$(dirname $(location api/shop/v1/shop.py))/../../.. && " +
          "echo 'export default ' > $$OUT && " +
          "$$READER api shop/v1/shop.py >> $$OUT",
    tools = ["//reboot/dashboard:api_reader"],
)

ts_project(
    name = "link_fields_to_data_types_test_ts",
    srcs = [
        "link_fields_to_data_types.test.ts",
        ":state_types.ts",
    ],
    declaration = True,
    tsconfig = {
        "compilerOptions": {
            "declaration": True,
            "module": "esnext",
            "moduleResolution": "bundler",
            "skipLibCheck": True,
            "target": "es2020",
        },
    },
    deps = [
        "//rbt/dashboard/v1:dashboard_js_proto",
        "//rbt/v1alpha1:schema_js_proto",
        "//reboot/dashboard/frontend:dashboard_ts",
        "//reboot/std/vitest:vitest_ts",
    ],
)

vitest_test(
    name = "link_fields_to_data_types_test",
    config = "vitest.config.mjs",
    data = [
        "package.json",
        ":link_fields_to_data_types_test_ts",
    ],
    node_modules = "//:node_modules",
    visibility = ["//visibility:public"],
)
