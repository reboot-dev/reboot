load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("//reboot:pydantic_to_proto.bzl", "py_reboot_library_from_pydantic")

py_library(
    name = "servicer_api_py",
    srcs = ["servicer_api.py"],
    deps = [
        "//reboot:api_py",
    ],
)

py_reboot_library_from_pydantic(
    name = "servicer_py_reboot",
    py_deps = [
        ":servicer_api_py",
    ],
    pydantic = ":servicer_api.py",
)

py_library(
    name = "servicer_py",
    srcs = ["servicer.py"],
    deps = [
        ":servicer_api_py",
        ":servicer_py_reboot",
    ],
)

py_test(
    name = "test_py",
    # This test drives 20 transactions into contention on a single
    # state, and a transaction that aborts under that contention retries
    # from the top. On the MacOS arm64 CI runner a retry storm has taken
    # it well past the 300s a `medium` test gets, from a usual ~15s, so
    # this one gets the 900s of a `large` test to work in.
    size = "large",
    srcs = ["test.py"],
    main = "test.py",
    deps = [
        ":servicer_py",
        "//reboot/aio:applications_py",
        "//reboot/aio:tests_py",
    ],
)
