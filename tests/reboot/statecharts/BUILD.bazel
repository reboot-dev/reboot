load("@com_github_grpc_grpc//bazel:python_rules.bzl", "py_proto_library")
load("@com_google_protobuf//bazel:proto_library.bzl", "proto_library")
load("@rbt_pypi//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("//reboot:pydantic_to_proto.bzl", "py_reboot_library_from_pydantic")
load("//reboot:rules.bzl", "py_reboot_library")

py_test(
    name = "validation_test",
    srcs = ["validation_test.py"],
    deps = [
        "//rbt/v1alpha1/statecharts:statechart_py_proto",
        "//reboot/statecharts:validation_py",
        requirement("protobuf"),
    ],
)

proto_library(
    name = "order_proto",
    srcs = ["order.proto"],
    deps = [
        "//rbt/v1alpha1:options_proto",
        "//rbt/v1alpha1/statecharts:statechart_proto",
        "@com_google_protobuf//:empty_proto",
    ],
)

py_reboot_library(
    name = "order_py_reboot",
    proto = "order.proto",
    proto_library = ":order_proto",
)

py_test(
    name = "servicer_test",
    srcs = ["servicer_test.py"],
    deps = [
        ":order_py_reboot",
        ":shipment_py_reboot",
        "//reboot/aio:contexts_py",
        requirement("protobuf"),
    ],
)

py_test(
    name = "statechart_test",
    srcs = ["statechart_test.py"],
    deps = [
        ":order_py_reboot",
        "//rbt/v1alpha1/statecharts:statechart_py_proto",
        "//reboot/aio:applications_py",
        "//reboot/aio:contexts_py",
        "//reboot/aio:tests_py",
        "//reboot/aio/auth:authorizers_py",
        "//reboot/statecharts:events_py",
        requirement("protobuf"),
    ],
)

py_test(
    name = "interpreter_test",
    srcs = ["interpreter_test.py"],
    deps = [
        ":order_py_reboot",
        "//rbt/v1alpha1/statecharts:statechart_py_proto",
        "//reboot/statecharts:events_py",
        "//reboot/statecharts:interpreter_py",
        requirement("protobuf"),
    ],
)

py_test(
    name = "events_test",
    srcs = ["events_test.py"],
    deps = [
        ":order_py_reboot",
        "//rbt/v1alpha1/statecharts:statechart_py_proto",
        "//reboot/statecharts:events_py",
        requirement("protobuf"),
    ],
)

proto_library(
    name = "shop_proto",
    srcs = ["shop.proto"],
)

py_proto_library(
    name = "shop_py_proto",
    deps = [":shop_proto"],
)

py_test(
    name = "transition_test",
    srcs = ["transition_test.py"],
    deps = [
        ":shop_py_proto",
        "//rbt/v1alpha1/statecharts:statechart_py_proto",
        "//reboot/statecharts:interpreter_py",
        requirement("protobuf"),
    ],
)

proto_library(
    name = "shipment_proto",
    srcs = ["shipment.proto"],
    deps = [
        "//rbt/v1alpha1:options_proto",
        "//rbt/v1alpha1/statecharts:statechart_proto",
        "@com_google_protobuf//:empty_proto",
    ],
)

py_reboot_library(
    name = "shipment_py_reboot",
    proto = "shipment.proto",
    proto_library = ":shipment_proto",
)

py_test(
    name = "activity_test",
    srcs = ["activity_test.py"],
    deps = [
        ":shipment_py_reboot",
        "//rbt/v1alpha1/statecharts:statechart_py_proto",
        "//reboot/aio:applications_py",
        "//reboot/aio:contexts_py",
        "//reboot/aio:tests_py",
        "//reboot/aio/auth:authorizers_py",
        "//reboot/statecharts:events_py",
        requirement("protobuf"),
    ],
)

py_library(
    name = "door_api_py",
    srcs = ["door_api.py"],
    deps = [
        "//rbt/v1alpha1/statecharts:statechart_py_proto",
        "//reboot:api_py",
        requirement("protobuf"),
    ],
)

py_reboot_library_from_pydantic(
    name = "door_py_reboot",
    py_deps = [
        ":door_api_py",
    ],
    pydantic = ":door_api.py",
)

py_test(
    name = "door_test",
    srcs = ["door_test.py"],
    deps = [
        ":door_api_py",
        ":door_py_reboot",
        "//rbt/v1alpha1/statecharts:statechart_py_proto",
        "//reboot:api_py",
        "//reboot:pydantic_api_py",
        "//reboot:pydantic_statechart_py",
        requirement("protobuf"),
    ],
)
