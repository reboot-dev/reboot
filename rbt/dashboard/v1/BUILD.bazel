load(
    "@com_github_reboot_dev_reboot//reboot:rules.bzl",
    "js_proto_library",
    "js_reboot_library",
    "js_reboot_react_library",
    "py_reboot_library",
)
load("@com_google_protobuf//bazel:proto_library.bzl", "proto_library")

proto_library(
    name = "dashboard_proto",
    srcs = [
        ":dashboard.proto",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_reboot_dev_reboot//rbt/v1alpha1:options_proto",
        "@com_github_reboot_dev_reboot//rbt/v1alpha1/api:api_proto",
        "@com_github_reboot_dev_reboot//rbt/v1alpha1/api:schema_proto",
        "@com_github_reboot_dev_reboot//rbt/v1alpha1/bdd:feature_proto",
        "@com_github_reboot_dev_reboot//rbt/v1alpha1/bdd:grammar_proto",
        "@com_google_protobuf//:duration_proto",
        "@com_google_protobuf//:struct_proto",
        "@com_google_protobuf//:timestamp_proto",
    ],
)

py_reboot_library(
    name = "dashboard_py_reboot",
    proto = "dashboard.proto",
    proto_library = ":dashboard_proto",
    visibility = ["//visibility:public"],
)

js_proto_library(
    name = "dashboard_js_proto",
    package_json = ":package.json",
    proto = "dashboard.proto",
    proto_deps = [
        ":dashboard_proto",
        # ISSUE(https://github.com/reboot-dev/mono/issues/3218): Until we can
        # use `create_protoc_plugin_rule` we need to repeat the dependencies of
        # the `proto_libraries` here.
        "@com_github_reboot_dev_reboot//rbt/v1alpha1:options_proto",
        "@com_github_reboot_dev_reboot//rbt/v1alpha1/api:api_proto",
        "@com_github_reboot_dev_reboot//rbt/v1alpha1/api:schema_proto",
        "@com_github_reboot_dev_reboot//rbt/v1alpha1/bdd:feature_proto",
        "@com_github_reboot_dev_reboot//rbt/v1alpha1/bdd:grammar_proto",
        "@com_google_protobuf//:descriptor_proto",
        "@com_google_protobuf//:duration_proto",
        "@com_google_protobuf//:timestamp_proto",
    ],
    visibility = ["//visibility:public"],
)

js_reboot_library(
    name = "dashboard_js_reboot",
    srcs = [
        ":dashboard_proto",
    ],
    proto = "dashboard.proto",
    visibility = ["//visibility:public"],
    deps = [
        ":dashboard_js_proto",
    ],
)

js_reboot_react_library(
    name = "dashboard_js_reboot_react",
    srcs = [
        ":dashboard_js_proto",
    ],
    proto = "dashboard.proto",
    proto_deps = [
        ":dashboard_proto",
        "@com_github_reboot_dev_reboot//rbt/v1alpha1:options_proto",
        "@com_github_reboot_dev_reboot//rbt/v1alpha1/api:api_proto",
        "@com_github_reboot_dev_reboot//rbt/v1alpha1/api:schema_proto",
        "@com_github_reboot_dev_reboot//rbt/v1alpha1/bdd:feature_proto",
        "@com_github_reboot_dev_reboot//rbt/v1alpha1/bdd:grammar_proto",
        "@com_google_protobuf//:descriptor_proto",
        "@com_google_protobuf//:duration_proto",
        "@com_google_protobuf//:timestamp_proto",
    ],
    visibility = ["//visibility:public"],
)

# The dashboard's page built into one file: an MCP host is given the
# page as a single resource, with no address to fetch a script or a
# stylesheet from. The page's two stylesheets and its bundle are
# written into it in place of the tags that load them. Built here,
# apart from the page's sources in `//reboot/dashboard/web`, because
# the `Dashboard` state type's `uis` name it by a path relative to
# this directory; see `dashboard.proto`.
genrule(
    name = "ui_dist",
    srcs = [
        "//:node_modules/@xyflow/react/dir",
        "//reboot/dashboard/web:dashboard.css",
        "//reboot/dashboard/web:dashboard_bundle_minified.js",
        "//reboot/dashboard/web:index.html",
    ],
    outs = ["ui/index.html"],
    cmd = "sed -e '/rel=\"stylesheet\"/d' -e '/rel=\"icon\"/d' " +
          "$(location //reboot/dashboard/web:index.html) " +
          "> $(@D)/index.template.html && " +
          "cat $(location //:node_modules/@xyflow/react/dir)/dist/style.css " +
          "$(location //reboot/dashboard/web:dashboard.css) " +
          "> $(@D)/index.css && " +
          "$(location //reboot/ping:inline_bundle) " +
          "$(@D)/index.template.html " +
          "$(location //reboot/dashboard/web:dashboard_bundle_minified.js) " +
          "$@ " +
          "--css $(@D)/index.css " +
          "--marker '<script type=\"module\" src=\"./src/main.tsx\"></script>' && " +
          "rm $(@D)/index.template.html $(@D)/index.css",
    tools = ["//reboot/ping:inline_bundle"],
)

# What reading the `Dashboard` state type's `uis` takes at runtime:
# the root marker and the page.
filegroup(
    name = "ui",
    srcs = [
        ".rbtrc",
        ":ui_dist",
    ],
    visibility = ["//reboot/dashboard/backend:__pkg__"],
)
