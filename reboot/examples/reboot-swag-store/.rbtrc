# Find API definitions in 'api/'.

generate api/

# Tell `rbt generate` where to put generated files.

generate --python=backend/api/

# Generate React bindings for web apps (into "frontend/api/").

generate --react=frontend/api

# Watch if any source files are modified.

dev run --watch=backend/\*_/_.py

# Tell `rbt` that this is a Python application.

dev run --python

# Save state between restarts.

dev run --application-name=reboot-swag-store

# Run the application!

dev run --application=backend/src/main.py

# Default to named URLs via portless (https://github.com/vercel-labs/portless)
# when no --config is specified: the app is https://reboot-swag-store.localhost, serving
# the MCP Apps from Vite, which runs as `cd frontend && npm run dev`
# (`portless frontend-reboot-swag-store vite`) at https://frontend-reboot-swag-store.localhost. Needs the
# `portless` CLI and its proxy (`portless proxy start`).
dev run --default-config=portless

# Hot Module Replacement (HMR): the MCP Apps are proxied from the Vite dev
# server through Envoy, in either config.


dev run:portless --portless
dev run:portless --frontend-url=https://frontend-reboot-swag-store.localhost
dev run:portless --mcp-app

# Plain ports instead: `rbt dev run --config=ports`, with Vite run as
# `cd frontend && npm run dev:ports`.
dev run:ports --frontend-url=http://localhost:5173
dev run:ports --mcp-app

# Dist mode: serve the built MCP Apps from "frontend/dist/mcp/" (no Vite HMR).

# Usage: uv run rbt dev run --config=dist

# Requires: cd frontend && npm run build

dev run:dist --mcp-app-dist-path=frontend/dist/mcp

# The developer dashboard (`rbt dashboard`) too: it is
# https://dashboard-reboot-swag-store.localhost by default, or on the plain port
# http://127.0.0.1:9871 with `rbt dashboard --config=ports`.
dashboard --default-config=portless
dashboard:portless --portless
dashboard:ports --no-portless

# When expunging, expunge that state we've saved.

dev expunge --application-name=reboot-swag-store

# --- Production (`rbt serve`) and Reboot Cloud deploys. ---

# Tell `rbt serve` that this is a Python application.

serve run --python
serve run --mcp-app-dist-path=frontend/dist/mcp

# Leave TLS termination to the external load balancer; expose a

# non-SSL port to that load balancer.

serve run --tls=external

# Run the application.

serve run --application=backend/src/main.py

# Name the application for every Cloud/serve subcommand that

# needs it, so `rbt cloud up` and friends operate on the same

# deployment as `rbt dev run`.

serve run --application-name=reboot-swag-store
cloud up --application-name=reboot-swag-store
cloud down --application-name=reboot-swag-store --expunge
cloud logs --application-name=reboot-swag-store
