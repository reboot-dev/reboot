# .rbtrc
# Find API definitions in 'api/'.
generate api/

# Generate Python code.
generate --python=backend/api/

# Generate React hooks.
generate --react=frontend/api

# Watch for source changes.
dev run --watch=backend/**/*.py
dev run --watch=frontend/dist/**/*.html

# Python application.
dev run --python

# Save state between restarts.
dev run --application-name=mcp-ui-counter

# Entrypoint.
dev run --application=backend/src/main.py

# Default to named URLs via portless (https://github.com/vercel-labs/portless)
# when no --config is specified: the app is https://mcp-ui-counter.localhost, serving
# the web app and the MCP UIs from Vite, which runs as `cd frontend && npm run dev`
# (`portless vite.mcp-ui-counter vite`) at https://vite.mcp-ui-counter.localhost. Needs the
# `portless` CLI and its proxy (`portless proxy start`).
dev run --default-config=portless

# Hot Module Replacement (HMR): the MCP UIs are proxied from the Vite dev
# server through Envoy, in either config.
dev run --mcp-app-path-prefix=frontend

dev run:portless --portless
dev run:portless --mcp-app-url=https://vite.mcp-ui-counter.localhost
dev run:portless --web-app-url=https://vite.mcp-ui-counter.localhost

# The developer dashboard (`rbt dashboard`) too: it is
# https://dashboard.mcp-ui-counter.localhost, where `rbt dev run --open-dashboard`
# finds it. `rbt dashboard --no-portless` for a plain port.
dashboard --portless

# Plain ports instead: `rbt dev run --config=hmr`, with Vite run as
# `cd frontend && npm run dev:hmr`.
dev run:hmr --mcp-app-url=http://localhost:5173
dev run:hmr --web-app-url=http://localhost:5173

# Dist mode: serve the built MCP UIs from "frontend/dist/" and the
# built web app at `/` (no Vite HMR).
# Usage: `uv run rbt dev run --config=dist`
# Requires: `cd frontend && npm run build`
dev run:dist --mcp-app-dist-path=frontend/dist
dev run:dist --web-app-dist-path=frontend/dist/web

# When expunging, expunge that state we've saved.
dev expunge --application-name=mcp-ui-counter

# Production: tell `rbt serve` this is a Python application and where the
# entrypoint lives. The Dockerfile's `CMD ["rbt", "serve", "run"]` picks
# these up.
serve run --python
serve run --mcp-app-dist-path=frontend/dist
serve run --mcp-app-path-prefix=frontend
serve run --web-app-dist-path=frontend/dist/web
serve run --application=backend/src/main.py

# Reboot Cloud terminates TLS at the external load balancer, so the app
# itself only exposes a non-TLS port.
serve run --tls=external

# Application name, used by `rbt cloud {up,down,logs}` and `rbt serve run`
# to identify this app.
serve run --application-name=mcp-ui-counter
cloud up --application-name=mcp-ui-counter
cloud down --application-name=mcp-ui-counter --expunge
cloud logs --application-name=mcp-ui-counter
