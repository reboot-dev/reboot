{
  "name": "reboot-counter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "echo 'choose between \"npm run dev:web-vite\" and \"npm run dev:web-next\"'",
    "dev:web-vite": "cd frontend && vite",
    "dev:web-next": "next dev ./frontend/web-next",
    "dev:backend": "rbt dev run",
    "build:web": "cd frontend && tsc -b && vite build"
  },
  "dependencies": {
    "@bufbuild/protobuf": "1.10.1",
    "@reboot-dev/reboot": "1.7.2",
    "@reboot-dev/reboot-react": "1.7.2",
    "next": "14.2.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.13",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
