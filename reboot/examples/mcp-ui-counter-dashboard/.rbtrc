# Find API definitions in 'api/'.
generate api/

# Generate Python code.
generate --python=backend/api/

# Generate React hooks.
generate --react=frontend/api

# Watch for source changes.
dev run --watch=backend/**/*.py
dev run --watch=frontend/dist/**/*.html

# Python application.
dev run --python

# Save state between restarts.
dev run --application-name=mcp-ui-counter-dashboard

# Entrypoint.
dev run --application=backend/src/main.py

# Default to named URLs via portless (https://github.com/vercel-labs/portless)
# when no --config is specified: the app is https://mcp-ui-counter-dashboard.localhost, serving
# the MCP UIs from Vite, which runs as `cd frontend && npm run dev`
# (`portless vite.mcp-ui-counter-dashboard vite`) at https://vite.mcp-ui-counter-dashboard.localhost. Needs the
# `portless` CLI and its proxy (`portless proxy start`).
dev run --default-config=portless

# Hot Module Replacement (HMR): the MCP UIs are proxied from the Vite dev
# server through Envoy, in either config.
dev run --mcp-app-path-prefix=frontend

dev run:portless --portless
dev run:portless --mcp-app-url=https://vite.mcp-ui-counter-dashboard.localhost

# Plain ports instead: `rbt dev run --config=hmr`, with Vite run as
# `cd frontend && npm run dev:hmr`.
dev run:hmr --mcp-app-url=http://localhost:5173

# Dist mode: serve pre-built artifacts from "frontend/dist/" (no Vite HMR).
# Usage: `uv run rbt dev run --config=dist`
# Requires: `cd frontend && npm run build`
dev run:dist --mcp-app-dist-path=frontend/dist

# When expunging, expunge that state we've saved.
dev expunge --application-name=mcp-ui-counter-dashboard
