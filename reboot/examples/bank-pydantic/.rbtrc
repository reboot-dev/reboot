# Find '.proto' files in 'api/'.
generate api/

# Tell `rbt generate` where to put generated files.
generate --python=backend/api

# Metro (React Native's bundler) resolves imports without file
# extensions, so we do not enable `--react-extensions`; the generated
# client's relative imports stay extensionless and resolve under both
# Vite (web) and Metro (mobile).
generate --react=frontend/api

# Watch if any generated or source files are modified.
dev run --watch=backend/**/*.py
dev run --watch=frontend/dist/**/*.html

# Tell `rbt` that this is a Python application.
dev run --python

# Save state between chaos restarts.
dev run --application-name=bank

# Run the application!
dev run --application=backend/src/main.py

# Default to HMR mode when no --config is specified.
dev run --default-config=hmr

# Hot Module Replacement (HMR): Vite dev server proxied through Envoy.
# Run Vite in a separate terminal: `cd frontend && npm run dev`
dev run --frontend-root-path=frontend

dev run:hmr --frontend-host=http://localhost:4444

# Dist mode: serve pre-built artifacts from "frontend/dist/" (no Vite
# HMR). Usage: `rbt dev run --config=dist`
# Requires: `cd frontend && npm run build`
dev run:dist --frontend-dist-path=frontend/dist

# When expunging, expunge that state we've saved.
dev expunge --application-name=bank

# Production (`rbt serve run`) settings, used by the `Dockerfile`
# when deploying to the Reboot Cloud. In production the built
# `frontend/dist/` is served from disk by the static-file server;
# the Vite dev server that `--frontend-host` points at is dev-only.
serve run --python
serve run --application=backend/src/main.py
serve run --application-name=bank
serve run --frontend-root-path=frontend
serve run --frontend-dist-path=frontend/dist

# Leave TLS termination to the external load balancer; expose a
# non-SSL port to that load balancer.
serve run --tls=external

# Application name for the `rbt cloud` commands.
cloud up --application-name=bank
cloud down --application-name=bank --expunge
cloud logs --application-name=bank
