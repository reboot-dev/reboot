{
  "expo": {
    "name": "Hebrew Birthdays",
    "slug": "hebrew-birthdays-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "hebrewbirthdays",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "dev.reboot.hebrewbirthdays"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-web-browser", "expo-secure-store"]
  }
}
