load("@rbt_pypi//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

py_library(
    name = "constants_py",
    srcs = ["constants.py"],
    srcs_version = "PY3",
    visibility = ["//visibility:public"],
)

py_library(
    name = "servicers_py",
    srcs = ["servicers.py"],
    srcs_version = "PY3",
    visibility = ["//visibility:public"],
    deps = [
        "//rbt/inspect/companion_app/v1:dashboard_py_reboot",
        "//reboot/aio:servicers_py",
        "//reboot/std/presence/v1:presence_py",
    ],
)

# Inline the JS bundle into the page's HTML, producing one
# self-contained file. `dashboard/index.html` must be *this* package's
# output, because the application serves it from beside its own module
# rather than from a project root; a `genrule` can only write within
# its own package.
genrule(
    name = "dashboard_dist",
    srcs = [
        "//reboot/inspect/companion_app/frontend:dashboard_bundle.js",
        "//reboot/inspect/companion_app/frontend:index.html",
    ],
    outs = ["dashboard/index.html"],
    cmd = "$(location //reboot/ping:inline_bundle) " +
          "$(location //reboot/inspect/companion_app/frontend:index.html) " +
          "$(location //reboot/inspect/companion_app/frontend:dashboard_bundle.js) " +
          "$@ " +
          "--marker '<script type=\"module\" src=\"./src/main.tsx\"></script>'",
    tools = ["//reboot/ping:inline_bundle"],
)

py_library(
    name = "main_py",
    srcs = [
        "main.py",
        "watcher.py",
    ],
    data = [
        ":dashboard_dist",
    ],
    srcs_version = "PY3",
    visibility = ["//visibility:public"],
    deps = [
        ":constants_py",
        ":servicers_py",
        "//rbt/v1alpha1/inspect:inspect_py_grpc",
        "//rbt/v1alpha1/inspect:inspect_py_proto",
        "//reboot/aio:applications_py",
        "//reboot/aio:external_py",
        "//reboot/aio:headers_py",
        "//reboot/aio/backoff:python",
        requirement("starlette"),
    ],
)

py_binary(
    name = "companion_app",
    srcs = [
        "main.py",
        "watcher.py",
    ],
    data = [
        ":dashboard_dist",
    ],
    main = "main.py",
    visibility = ["//visibility:public"],
    deps = [
        ":constants_py",
        ":servicers_py",
        "//rbt/v1alpha1/inspect:inspect_py_grpc",
        "//rbt/v1alpha1/inspect:inspect_py_proto",
        "//reboot/aio:applications_py",
        "//reboot/aio:external_py",
        "//reboot/aio:headers_py",
        "//reboot/aio/backoff:python",
        requirement("starlette"),
    ],
)
