load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@rbt_pypi//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library")

py_library(
    name = "blob_py",
    srcs = [
        "_content_type.py",
        "_data_plane.py",
        "_filesystem_data_plane.py",
        "_http.py",
        "_store.py",
        "_stored_blob.py",
        "blob.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//reboot/aio:applications_py",
        "//reboot/aio:contexts_py",
        "//reboot/aio:external_py",
        "//reboot/aio:http_py",
        "//reboot/aio:workflows_py",
        "//reboot/aio/auth:authorizers_py",
        "//reboot/controller:settings_py",
        "//reboot/crypto:root_keys_py",
        "@com_github_reboot_dev_reboot//log:log_py",
        "@com_github_reboot_dev_reboot//rbt/std/blob/v1:blob_py_reboot",
        "@com_github_reboot_dev_reboot//rbt/std/blob/v1:data_plane_py_reboot",
        "@com_github_reboot_dev_reboot//rbt/std/blob/v1:filesystem_py_reboot",
        "@com_github_reboot_dev_reboot//rbt/v1alpha1:placement_planner_py_proto",
        "@com_github_reboot_dev_reboot//reboot:run_environments_py",
        requirement("aiofiles"),
        requirement("grpcio"),
        requirement("starlette"),
    ],
)

ts_project(
    name = "blob_ts",
    srcs = [
        "index.ts",
        "package.json",
    ],
    declaration = True,
    tsconfig = {
        "compilerOptions": {
            "declaration": True,
            "module": "nodenext",
            "moduleResolution": "nodenext",
            "target": "es2020",
        },
    },
    visibility = ["//visibility:public"],
    deps = [
        "//:node_modules/@reboot-dev/reboot",
        "//:node_modules/@reboot-dev/reboot-std-api",
        "//:node_modules/@types/node",
    ],
