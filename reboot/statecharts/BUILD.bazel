load("@rbt_pypi//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library")

py_library(
    name = "validation_py",
    srcs = ["validation.py"],
    srcs_version = "PY3",
    visibility = ["//visibility:public"],
    deps = [
        "//rbt/v1alpha1/statecharts:statechart_py_proto",
    ],
)

py_library(
    name = "events_py",
    srcs = ["events.py"],
    srcs_version = "PY3",
    visibility = ["//visibility:public"],
    deps = [
        "//rbt/v1alpha1/statecharts:statechart_py_proto",
        requirement("protobuf"),
    ],
)

py_library(
    name = "interpreter_py",
    srcs = ["interpreter.py"],
    srcs_version = "PY3",
    visibility = ["//visibility:public"],
    deps = [
        ":events_py",
        ":validation_py",
        "//rbt/v1alpha1/statecharts:statechart_py_proto",
        requirement("protobuf"),
    ],
)
