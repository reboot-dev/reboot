const SHARD: &str = "s000000000";
const MAP: &str = "rbt.std.collections.v1.SortedMap";
// Optional local-development administration; no baked-in credential.
// Production apps should supply their own identity-provider verifier/authorizer.
struct TaskAdmin(String);
impl reboot::auth::TokenVerifier for TaskAdmin {
    fn verify<'a>(
        &'a self,
        _: &'a reboot::auth::AuthorizationContext,
        token: Option<&'a str>,
    ) -> reboot::auth::VerifyFuture<'a> {
        Box::pin(async move {
            if token == Some(self.0.as_str()) {
                reboot::auth::TokenVerification::Authenticated(reboot::auth::Auth::new(
                    serde_json::json!({"task_admin": true}),
                ))
            } else {
                reboot::auth::TokenVerification::Unauthenticated {
                    message: "task admin credential required".into(),
                }
            }
        })
    }
}
impl reboot::auth::Authorizer for TaskAdmin {
    fn authorize<'a>(
        &'a self,
        context: &'a reboot::auth::AuthorizationContext,
        auth: Option<&'a reboot::auth::Auth>,
        state: Option<&'a [u8]>,
        _: &'a [u8],
    ) -> reboot::auth::AuthorizeFuture<'a> {
        Box::pin(async move {
            if matches!(
                context.method.as_str(),
                "rbt.v1alpha1.Tasks.ListTasks"
                    | "rbt.v1alpha1.Tasks.ListTasksStream"
                    | "rbt.v1alpha1.Tasks.CancelTask"
            ) && state.is_none()
                && auth.is_some_and(|auth| auth.payload()["task_admin"] == true)
            {
                reboot::auth::AuthorizationDecision::Allow
            } else {
                reboot::auth::AuthorizationDecision::PermissionDenied {
                    message: "task administration denied".into(),
                }
            }
        })
    }
}
// Only StopBatch gains new credential policy. Existing development RPCs retain
// their old access rules; no client header can grant task or completion authority.
struct StopAccess(Option<Arc<TaskAdmin>>);
impl reboot::auth::TokenVerifier for StopAccess {
    fn verify<'a>(
        &'a self,
        context: &'a reboot::auth::AuthorizationContext,
        token: Option<&'a str>,
    ) -> reboot::auth::VerifyFuture<'a> {
        if context.method != "{{ name }}.v1.LedgerWorkMethods.StopBatch" {
            return Box::pin(async { reboot::auth::TokenVerification::NoOpinion });
        }
        match &self.0 {
            Some(admin) => reboot::auth::TokenVerifier::verify(admin.as_ref(), context, token),
            None => Box::pin(async { reboot::auth::TokenVerification::NoOpinion }),
        }
    }
}
impl reboot::auth::Authorizer for StopAccess {
    fn authorize<'a>(
        &'a self,
        context: &'a reboot::auth::AuthorizationContext,
        auth: Option<&'a reboot::auth::Auth>,
        state: Option<&'a [u8]>,
        _: &'a [u8],
    ) -> reboot::auth::AuthorizeFuture<'a> {
        Box::pin(async move {
            if context.method != "{{ name }}.v1.LedgerWorkMethods.StopBatch"
                || (context.state_type == STATE_TYPE
                    && state.is_some()
                    && auth.is_some_and(|a| a.payload()["task_admin"] == true))
            {
                reboot::auth::AuthorizationDecision::Allow
            } else {
                reboot::auth::AuthorizationDecision::PermissionDenied {
                    message: "cooperative stop requires configured task admin".into(),
                }
            }
        })
    }
}
// Opt-in revocable local-development result access, separate from task admin.
// The file contains {"token": "...", "task_uuid": "..."}; missing/malformed
// grants fail closed. Production applications own their verifier/authorizer.
struct TaskResultAccess(std::path::PathBuf);
impl TaskResultAccess {
    async fn grant(&self) -> Option<serde_json::Value> {
        use tokio::io::AsyncReadExt;
        let metadata = tokio::fs::metadata(&self.0).await.ok()?;
        if !metadata.is_file() || metadata.len() > 4096 {
            return None;
        }
        let file = tokio::fs::File::open(&self.0).await.ok()?;
        let metadata = file.metadata().await.ok()?;
        if !metadata.is_file() || metadata.len() > 4096 {
            return None;
        }
        let mut bytes = Vec::new();
        file.take(4097).read_to_end(&mut bytes).await.ok()?;
        if bytes.len() > 4096 {
            return None;
        }
        serde_json::from_slice(&bytes).ok()
    }
}
impl reboot::auth::TokenVerifier for TaskResultAccess {
    fn verify<'a>(
        &'a self,
        _: &'a reboot::auth::AuthorizationContext,
        token: Option<&'a str>,
    ) -> reboot::auth::VerifyFuture<'a> {
        Box::pin(async move {
            if let Some(token) = token.filter(|token| !token.is_empty())
                && self
                    .grant()
                    .await
                    .is_some_and(|grant| grant["token"].as_str() == Some(token))
            {
                reboot::auth::TokenVerification::Authenticated(reboot::auth::Auth::new(
                    serde_json::json!({"task_result_token": token}),
                ))
            } else {
                reboot::auth::TokenVerification::Unauthenticated {
                    message: "task result credential required".into(),
                }
            }
        })
    }
}
impl reboot::auth::Authorizer for TaskResultAccess {
    fn authorize<'a>(
        &'a self,
        context: &'a reboot::auth::AuthorizationContext,
        auth: Option<&'a reboot::auth::Auth>,
        state: Option<&'a [u8]>,
        request: &'a [u8],
    ) -> reboot::auth::AuthorizeFuture<'a> {
        Box::pin(async move {
            use prost::Message;
            let grant = self.grant().await;
            let allowed = (|| {
                let grant = grant?;
                let principal = auth?.payload()["task_result_token"].as_str()?;
                let task = db::WaitRequest::decode(request).ok()?.task_id?;
                let uuid = Uuid::from_slice(&task.task_uuid).ok()?;
                Some(
                    context.method == "rbt.v1alpha1.Tasks.Wait"
                        && context.state_type == STATE_TYPE
                        && state.is_none()
                        && task.state_type == STATE_TYPE
                        && task.state_ref == context.headers.state_ref
                        && grant["token"].as_str() == Some(principal)
                        && grant["task_uuid"].as_str() == Some(uuid.to_string().as_str()),
                )
            })()
            .unwrap_or(false);
            if allowed {
                reboot::auth::AuthorizationDecision::Allow
            } else {
                reboot::auth::AuthorizationDecision::PermissionDenied {
                    message: "task result access denied".into(),
                }
            }
        })
    }
}
pub struct Starts;
impl RootTransactionStartFactory for Starts {
    fn next_root_transaction(&self) -> Result<RootTransactionStart, Status> {
        Ok(RootTransactionStart {
            transaction_id: Uuid::new_v4(),
            timestamp: prost_types::Timestamp::default(),
        })
    }
}
impl InboundTransactionStartFactory for Starts {
    fn next_inbound_transaction(
        &self,
        _: &reboot::runtime::InboundTransactionContext,
    ) -> Result<Uuid, Status> {
        Err(Status::failed_precondition(
            "batch ledger supports fresh local roots only",
        ))
    }
}
pub struct Routes {
    entries:
        BTreeMap<ParticipantTarget, Arc<InProcessParticipantEndpoint<TonicParticipantSidecar>>>,
}
impl ParticipantResolver for Routes {
    type Endpoint = InProcessParticipantEndpoint<TonicParticipantSidecar>;
    fn resolve(
        &self,
        target: &ParticipantTarget,
    ) -> Pin<Box<dyn Future<Output = Result<Arc<Self::Endpoint>, Status>> + Send + '_>> {
        let result =
            self.entries.get(target).cloned().ok_or_else(|| {
                Status::failed_precondition("unregistered batch ledger participant")
            });
        Box::pin(async move { result })
    }
}
struct Watch(DurableCoordinatorWatchHost<TonicCoordinatorSidecar>);
impl CoordinatorWatchEndpoint for Watch {
    fn watch(&self, request: db::WatchRequest) -> CoordinatorWatchFuture<'_, db::WatchResponse> {
        Box::pin(async move {
            use db::coordinator_server::Coordinator;
            self.0
                .watch(tonic::Request::new(request))
                .await
                .map(tonic::Response::into_inner)
        })
    }
}
struct CombinedReaders<W, I> {
    work: W,
    index: I,
}
#[tonic::async_trait]
impl<W: reboot::reactive::ReaderBinding, I: reboot::reactive::ReaderBinding>
    reboot::reactive::ReaderBinding for CombinedReaders<W, I>
{
    fn validate_owner(&self, owner: &reboot::reactive::LocalReaderOwner) -> Result<(), Status> {
        self.work.validate_owner(owner)?;
        self.index.validate_owner(owner)
    }
    async fn read(
        &self,
        request: tonic::Request<reboot::reactive::wire::Query>,
    ) -> Result<Vec<u8>, Status> {
        if request
            .get_ref()
            .method
            .starts_with("{{ name }}.v1.LedgerWorkMethods.")
        {
            self.work.read(request).await
        } else {
            self.index.read(request).await
        }
    }
}
struct ReaderTelemetry(reboot::reactive::LocalReaderOwner);
#[tonic::async_trait]
impl HostRecovery for ReaderTelemetry {
    async fn start(
        &self,
        children: &mut tokio::task::JoinSet<Result<(), Status>>,
        cancel: RecoveryCancellation,
    ) -> Result<(), Status> {
        let readers = self.0.clone();
        children.spawn(async move {
            let mut prior = None;
            loop {
                let count = readers.active_subscriptions();
                if prior != Some(count) { eprintln!("batch-ledger-active-readers {count}"); prior = Some(count); }
                tokio::select! { _ = cancel.cancelled() => return Ok(()), _ = tokio::time::sleep(std::time::Duration::from_millis(25)) => {} }
            }
        });
        Ok(())
    }
}
struct MapConstructor {
    library: reboot::sorted_map::SortedMapLibrary,
    state_ref: String,
    key: Uuid,
}
#[tonic::async_trait]
impl HostRecovery for MapConstructor {
    async fn start(
        &self,
        _: &mut tokio::task::JoinSet<Result<(), Status>>,
        _: RecoveryCancellation,
    ) -> Result<(), Status> {
        // Stable logical EMPTY constructor replay, AFTER all native ownership recovery.
        generated_map::SortedMap::create(&self.library, &self.state_ref, self.key).await?;
        Ok(())
    }
}
#[allow(clippy::result_large_err)]
fn placement(
    application: &str,
    address: SocketAddr,
) -> Result<reboot::legacy_placement::PlanOnlyLegacyPlacement, Status> {
    use reboot::placement_proto as p;
    let plan = reboot::legacy_placement::PlanOnlyLegacyPlacement::new();
    plan.install(p::ListenForPlanResponse {
        plan: Some(p::Plan {
            version: 1,
            applications: vec![p::plan::Application {
                id: application.into(),
                services: [
                    "{{ name }}.v1.LedgerWorkMethods",
                    "{{ name }}.v1.LedgerIndexMethods",
                    "rbt.v1alpha1.Tasks",
                ]
                .into_iter()
                .map(|name| p::plan::application::Service {
                    full_name: name.into(),
                    state_type_full_name: STATE_TYPE.into(),
                })
                .collect(),
                shards: vec![p::plan::application::Shard {
                    id: SHARD.into(),
                    range: Some(p::plan::application::shard::KeyRange { first_key: vec![] }),
                    server_id: "local-rust".into(),
                    replica_index: 0,
                }],
            }],
        }),
        servers: vec![p::Server {
            id: "local-rust".into(),
            application_id: application.into(),
            address: Some(p::server::Address {
                host: address.ip().to_string(),
                port: i32::from(address.port()),
            }),
            ..Default::default()
        }],
    })?;
    Ok(plan)
}
pub async fn serve(
    endpoint: String,
    address: SocketAddr,
    application: String,
    shutdown: impl Future<Output = ()> + Send + 'static,
) -> Result<(), Box<dyn std::error::Error>> {
    let reference = crate::reference()?;
    let map_ref = reboot::state_ref::StateRef::from_id(MAP, "approvals")?.to_string();
    let archive_ref = reboot::state_ref::StateRef::from_id(MAP, "archived-approvals")?.to_string();
    let store = DatabaseActorStore::connect(endpoint.clone()).await?;
    let sidecar = Arc::new(TonicParticipantSidecar::connect(endpoint.clone()).await?);
    let participant = DurableActorParticipant::new(sidecar, STATE_TYPE, &reference)
        .with_database_actor_gate(&store);
    let library = reboot::sorted_map::SortedMapLibrary::new(store.clone()).await?;
    let map = generated_map::SortedMap::target(&library, &map_ref)?;
    let map_participant = map.participant();
    let archive = generated_map::SortedMap::target(&library, &archive_ref)?;
    let archive_participant = archive.participant();
    let routes = Routes {
        entries: [
            participant.clone(),
            map_participant.clone(),
            archive_participant.clone(),
        ]
        .into_iter()
        .map(|participant| {
            (
                participant.actor_target(),
                Arc::new(InProcessParticipantEndpoint::new(
                    DurableActorParticipantHost::new(participant),
                )),
            )
        })
        .collect(),
    };
    let coordinator_sidecar = Arc::new(TonicCoordinatorSidecar::connect(endpoint).await?);
    let coordinator = DurableRootCoordinator::new(coordinator_sidecar.clone(), Arc::new(routes))
        .with_identity(participant.actor_target());
    let abort_owner = reboot::explicit_abort::ExplicitAbortOwner::new(8)?;
    let index = generated::LedgerIndexMethodsTransactionAdapter::new(
        store.clone(),
        participant.clone(),
        coordinator.clone(),
        Starts,
        Index { map, archive },
    )
    .with_explicit_abort_owner(abort_owner);
    let abort_recovery = index.explicit_abort_recovery_registration()?;
    let participant_metadata = ParticipantRecovery {
        shard_ids: vec![SHARD.into()],
        ..Default::default()
    };
    let recovery = LegacyDurableRecovery::new(
        participant,
        coordinator,
        LegacyRecoveryMetadata {
            participant: participant_metadata.clone(),
            coordinator: CoordinatorRecovery {
                shard_ids: vec![SHARD.into()],
                coordinator_state_ref: reference.clone(),
                ..Default::default()
            },
        },
        Arc::new(Watch(DurableCoordinatorWatchHost::new(
            coordinator_sidecar,
            STATE_TYPE,
            &reference,
        )?)),
    )?
    .with_participant(map_participant, participant_metadata.clone())?
    .with_participant(archive_participant, participant_metadata)?;
    let admin = match std::env::var("RBT_RUST_TASK_ADMIN_TOKEN") {
        Ok(token) if !token.is_empty() => Some(Arc::new(TaskAdmin(token))),
        Ok(_) => return Err("task admin token must not be empty".into()),
        Err(std::env::VarError::NotPresent) => None,
        Err(error) => return Err(error.into()),
    };
    let stop_access = Arc::new(StopAccess(admin.clone()));
    let (work, tasks) = generated::LedgerWorkMethodsDatabaseAdapter::new(store.clone(), Ledger)
        .with_authorization(reboot::auth::AuthorizationPolicy::new(
            Some(stop_access.clone()),
            Some(stop_access),
        ))
        .with_workflows(&reference)?;
    let (readers, _) = index.local_readers(&reference)?;
    let companion = reboot::reactive::LocalReaderService::new(
        CombinedReaders {
            work: work.clone(),
            index: index.clone(),
        },
        readers.clone(),
    )?;
    let wait = reboot::one_shot_tasks::ReaderTaskWaitService::new(
        [tasks.clone()],
        reboot::legacy_placement::LegacyApplicationId::new(&application)?,
        "local-rust",
        placement(&application, address)?,
    )?;
    let wait = match admin {
        Some(admin) => wait.with_admin_authorization(admin.clone(), admin),
        None => wait,
    };
    let wait = match std::env::var_os("RBT_RUST_TASK_RESULT_GRANT") {
        Some(path) => {
            let policy = Arc::new(TaskResultAccess(path.into()));
            wait.with_wait_authorization(policy.clone(), policy)
        }
        None => wait,
    };
    let wait = db::tasks_server::TasksServer::new(wait);
    let reader_monitor = readers.clone();
    ApplicationHost::new(application)
        .with_host_recovery(recovery)
        .with_host_recovery(MapConstructor {
            library: library.clone(),
            state_ref: map_ref,
            key: Uuid::from_u128(0x6c65646765724d61b043726561740001),
        })
        .with_host_recovery(MapConstructor {
            library,
            state_ref: archive_ref,
            key: Uuid::from_u128(0x6c65646765724d61b043726561740002),
        })
        .with_host_recovery(abort_recovery)
        .with_host_recovery(tasks.recovery(db::RecoverRequest {
            state_tags_by_state_type: [(STATE_TYPE.into(), "Ledger".into())].into(),
            shard_ids: vec![SHARD.into()],
            skip_idempotent_mutations: true,
        }))
        .with_host_recovery(readers)
        .with_host_recovery(ReaderTelemetry(reader_monitor.clone()))
        .add_public_service(proto::ledger_work_methods_server::LedgerWorkMethodsServer::new(work))
        .add_public_service(
            proto::ledger_index_methods_server::LedgerIndexMethodsServer::new(index),
        )
        .add_public_service(wait)
        .try_add_local_readers(companion)?
        .serve_with_shutdown(address, shutdown)
        .await?;
    assert_eq!(
        reader_monitor.active_subscriptions(),
        0,
        "host drained typed readers"
    );
    Ok(())
}
