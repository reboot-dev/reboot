use reboot::ExternalContext;
use {{ name }}::{generated, proto};
use std::time::Duration;

#[tokio::main]
async fn main() -> Result<(), Box<dyn std::error::Error>> {
    let args: Vec<String> = std::env::args().collect();
    let command = args
        .get(1)
        .ok_or("usage: client <create|greet|read|health> [state-ref] [idempotency-key]")?;
    let endpoint = std::env::var("RBT_RUST_URL").unwrap_or_else(|_| "http://127.0.0.1:9990".into());
    let context = ExternalContext::new(args.get(2).cloned().unwrap_or_else(|| "hello".into()));
    let channel = tokio::time::timeout(Duration::from_secs(2), context.connect(endpoint)).await??;
    if command == "health" {
        let mut health = tonic_health::pb::health_client::HealthClient::new(channel);
        let mut request = tonic::Request::new(tonic_health::pb::HealthCheckRequest {
            service: String::new(),
        });
        request.set_timeout(Duration::from_secs(1));
        let response = health.check(request).await?.into_inner();
        if response.status != tonic_health::pb::health_check_response::ServingStatus::Serving as i32
        {
            return Err("application is not ready".into());
        }
        println!("SERVING");
        return Ok(());
    }
    let mut client = generated::HelloWorldMethodsExternalClient::new(channel, context);
    let operation = async {
        let count = match command.as_str() {
            "create" => {
                let key = args
                    .get(3)
                    .map(|v| uuid::Uuid::parse_str(v))
                    .transpose()?
                    .unwrap_or_else(uuid::Uuid::new_v4);
                client
                    .create_with_key(proto::CreateRequest {}, key)
                    .await?
                    .into_inner()
                    .number_of_greetings
            }
            "greet" => {
                let key = args
                    .get(3)
                    .map(|v| uuid::Uuid::parse_str(v))
                    .transpose()?
                    .unwrap_or_else(uuid::Uuid::new_v4);
                client
                    .greet_with_key(proto::GreetRequest {}, key)
                    .await?
                    .into_inner()
                    .number_of_greetings
            }
            "read" => {
                client
                    .num_greetings(proto::NumGreetingsRequest {})
                    .await?
                    .into_inner()
                    .number_of_greetings
            }
            _ => return Err("unknown command; use create, greet, read or health".into()),
        };
        println!("{count}");
        Ok::<(), Box<dyn std::error::Error>>(())
    };
    tokio::time::timeout(Duration::from_secs(5), operation).await??;
    Ok(())
}
