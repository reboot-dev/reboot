use {{ name }}::{generated, proto};
use std::time::Duration;
fn work_reader_status(error: generated::LedgerWorkMethodsObserveBatchError) -> tonic::Status {
    match error {
        generated::LedgerWorkMethodsObserveBatchError::BatchMismatch(error) => {
            reboot::declared_error_status(
                tonic::Code::Unknown,
                "declared error",
                "type.googleapis.com/{{ name }}.v1.BatchMismatch",
                &error,
            )
        }
        generated::LedgerWorkMethodsObserveBatchError::Grpc(error) => error,
    }
}

fn index_status(error: generated::LedgerIndexMethodsApprovalSnapshotError) -> tonic::Status {
    match error {
        generated::LedgerIndexMethodsApprovalSnapshotError::BatchMismatch(error) => {
            reboot::declared_error_status(
                tonic::Code::Unknown,
                "declared error",
                "type.googleapis.com/{{ name }}.v1.BatchMismatch",
                &error,
            )
        }
        generated::LedgerIndexMethodsApprovalSnapshotError::System(system) => {
            system.error.into_status(system.message)
        }
        generated::LedgerIndexMethodsApprovalSnapshotError::Grpc(error) => error,
    }
}
fn show(state: proto::Ledger) {
    println!(
        "{} {} {} {} {}",
        state.batch, state.count, state.approved, state.completed, state.submissions
    );
}
fn show_tasks(
    tasks: Vec<reboot::database_proto::TaskInfo>,
) -> Result<(), Box<dyn std::error::Error>> {
    for task in tasks {
        let id = task.task_id.ok_or("listed task lacks identity")?;
        let phase = reboot::database_proto::task_info::Status::try_from(task.status)?;
        let occurred = task
            .occurred_at
            .ok_or("listed task lacks phase timestamp")?;
        let due = task
            .scheduled_at
            .map(|time| format!("{}.{:09}", time.seconds, time.nanos))
            .unwrap_or_else(|| "-".into());
        println!(
            "{} {} {} {}.{:09} {} {} {}",
            uuid::Uuid::from_slice(&id.task_uuid)?,
            phase.as_str_name(),
            task.method,
            occurred.seconds,
            occurred.nanos,
            due,
            task.iterations,
            task.num_runs_failed_recently
        );
    }
    Ok(())
}
