#[allow(clippy::result_large_err)]
fn validate_batch(batch: &str, count: u32) -> Result<(), tonic::Status> {
    if batch.is_empty()
        || batch.len() > 48
        || !batch
            .bytes()
            .all(|c| c.is_ascii_alphanumeric() || c == b'-')
        || count == 0
        || count > 100
    {
        return Err(tonic::Status::invalid_argument(
            "batch must be bounded ASCII; count must be 1..100",
        ));
    }
    Ok(())
}
