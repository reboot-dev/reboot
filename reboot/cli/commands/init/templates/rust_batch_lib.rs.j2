pub const STATE_TYPE: &str = "{{ name }}.v1.Ledger";
pub fn reference() -> Result<String, Box<dyn std::error::Error>> {
    Ok(reboot::state_ref::StateRef::from_id(STATE_TYPE, "ledger")?.to_string())
}
#[allow(clippy::result_large_err)]
fn validate_batch(batch: &str, count: u32) -> Result<(), tonic::Status> {
    if batch.is_empty()
        || batch.len() > 48
        || !batch
            .bytes()
            .all(|c| c.is_ascii_alphanumeric() || c == b'-')
        || count == 0
        || count > 100
    {
        return Err(tonic::Status::invalid_argument(
            "batch must be bounded ASCII; count must be 1..100",
        ));
    }
    Ok(())
}
/// Append-only handler entries are visible in the normal rbt host log.
fn event(name: &str) {
    eprintln!("batch-ledger-handler {name}");
}
#[derive(Clone)]
pub struct Ledger;
#[tonic::async_trait]
impl generated::LedgerWorkMethodsDatabaseHandler for Ledger {
    async fn create(
        &self,
        _: &mut proto::Ledger,
        _: proto::Empty,
    ) -> Result<proto::Empty, tonic::Status> {
        Ok(proto::Empty {})
    }
    async fn observe(
        &self,
        state: &proto::Ledger,
        _: proto::Empty,
    ) -> Result<proto::Ledger, tonic::Status> {
        Ok(state.clone())
    }
    async fn submit_batch(
        &self,
        _: &mut proto::Ledger,
        _: proto::Submit,
    ) -> Result<proto::Handle, tonic::Status> {
        Err(tonic::Status::failed_precondition(
            "requires generated scheduling writer",
        ))
    }
    async fn submit_batch_scheduled(
        &self,
        state: &mut proto::Ledger,
        request: proto::Submit,
        state_ref: String,
    ) -> Result<TransactionExecution<proto::Handle>, tonic::Status> {
        validate_batch(&request.batch, request.count)?;
        if state.completed < state.count && !state.rejected {
            return Err(tonic::Status::failed_precondition("previous batch pending"));
        }
        if request.reject_after > request.count {
            return Err(tonic::Status::invalid_argument(
                "reject_after exceeds count",
            ));
        }
        let timestamp = (request.not_before != 0).then_some(prost_types::Timestamp {
            seconds: request.not_before,
            nanos: 0,
        });
        let task = generated::LedgerWorkMethodsTasks::run_batch(&state_ref, &request, timestamp);
        let id = task
            .task_id
            .as_ref()
            .ok_or_else(|| tonic::Status::internal("missing generated task identity"))?
            .task_uuid
            .clone();
        state.batch = request.batch;
        state.count = request.count;
        state.approved = 0;
        state.completed = 0;
        state.rejected = false;
        state.submissions += 1;
        let mut execution = TransactionExecution::new(proto::Handle { id });
        execution.task_upserts.push(task);
        Ok(execution)
    }
    async fn checkpoint(
        &self,
        state: &mut proto::Ledger,
        request: proto::Step,
    ) -> Result<proto::Ledger, tonic::Status> {
        if state.rejected
            || state.batch != request.batch
            || state.completed != request.index
            || state.approved <= request.index
        {
            return Err(tonic::Status::failed_precondition(
                "checkpoint identity or approval mismatch",
            ));
        }
        event(&format!("checkpoint-{}-{}", request.batch, request.index));
        state.completed += 1;
        state.rejected = request.reject;
        Ok(state.clone())
    }
    // Ordinary public Checkpoint RPCs use this scheduling hook. Only the private
    // workflow-step binding invokes checkpoint directly with dispatcher authority.
    async fn checkpoint_scheduled(
        &self,
        _: &mut proto::Ledger,
        _: proto::Step,
        _: String,
    ) -> Result<TransactionExecution<proto::Ledger>, tonic::Status> {
        Err(tonic::Status::permission_denied(
            "checkpoint requires private workflow authority",
        ))
    }
    async fn run_batch(
        &self,
        context: &WorkflowContext<'_>,
        request: proto::Submit,
    ) -> Result<proto::Ledger, generated::LedgerWorkMethodsRunBatchError> {
        validate_batch(&request.batch, request.count)?;
        if request.reject_after > request.count {
            return Err(tonic::Status::invalid_argument("reject_after exceeds count").into());
        }
        event(&format!("body-{}", request.batch));
        let mut result = proto::Ledger::default();
        for index in 0..request.count {
            let iteration =
                context.iteration("batch-v1", u64::from(index), u64::from(request.count))?;
            let batch = request.batch.clone();
            generated::LedgerWorkMethodsWorkflowSteps::observe_until(
                &iteration,
                Arc::new(self.clone()),
                "approval",
                "approved-through-index.v1",
                proto::Empty {},
                move |state| state.batch == batch && state.approved > index,
            )
            .await?;
            result = generated::LedgerWorkMethodsWorkflowSteps::checkpoint(
                &iteration,
                Arc::new(self.clone()),
                "complete",
                proto::Step {
                    batch: request.batch.clone(),
                    index,
                    reject: request.reject_after == index + 1,
                },
            )
            .await?;
            if result.rejected {
                return Err(generated::LedgerWorkMethodsRunBatchError::BatchRejected(
                    proto::BatchRejected {
                        batch: request.batch.clone(),
                        completed: result.completed,
                        reason: "rejected after acknowledged checkpoint".into(),
                    },
                ));
            }
        }
        Ok(result)
    }
}
fn archive_rejection(key: String, reason: &str) -> tonic::Status {
    // Preserve the existing Status handler contract; the generated typed
    // transaction-result hook validates this method-scoped declared envelope.
    reboot::declared_error_status(
        tonic::Code::Unknown,
        reason,
        "type.googleapis.com/{{ name }}.v1.ArchiveRejected",
        &proto::ArchiveRejected {
            key,
            reason: reason.into(),
        },
    )
}
fn increment_archive_count(state: &mut proto::Ledger) -> Result<(), Box<tonic::Status>> {
    state.archived = state
        .archived
        .checked_add(1)
        .ok_or_else(|| Box::new(tonic::Status::resource_exhausted("archive count overflow")))?;
    Ok(())
}
pub struct Index {
    pub map: generated_map::SortedMap,
    pub archive: generated_map::SortedMap,
}
#[tonic::async_trait]
impl generated::LedgerIndexMethodsTransactionHandler for Index {
    async fn approval_snapshot(
        &self,
        state: &proto::Ledger,
        request: proto::Batch,
    ) -> Result<proto::Ledger, generated::LedgerIndexMethodsApprovalSnapshotError> {
        if !request.batch.is_empty() && request.batch != state.batch {
            return Err(
                generated::LedgerIndexMethodsApprovalSnapshotError::BatchMismatch(
                    proto::BatchMismatch {
                        expected: request.batch,
                        actual: state.batch.clone(),
                    },
                ),
            );
        }
        Ok(state.clone())
    }
    async fn approve(
        &self,
        context: &TransactionContext,
        state: &mut proto::Ledger,
        request: proto::Approval,
    ) -> Result<TransactionExecution<proto::Ledger>, tonic::Status> {
        if state.rejected
            || state.batch != request.batch
            || request.index != state.approved
            || request.index >= state.count
        {
            return Err(tonic::Status::invalid_argument(
                "approval must be the next active batch index",
            ));
        }
        let guard = self.map.in_transaction(context).await?;
        guard
            .insert(reboot::sorted_map_proto::InsertRequest {
                entries: [(format!("{}:{:04}", request.batch, request.index), vec![])].into(),
            })
            .await?;
        state.approved += 1;
        if request.invalid_range {
            // Catch deliberately: the nested failure must still doom the whole root.
            guard
                .range(reboot::sorted_map_proto::RangeRequest {
                    limit: 0,
                    ..Default::default()
                })
                .await
                .expect_err("invalid range accepted");
        }
        Ok(TransactionExecution::new(state.clone()))
    }
    async fn archive_entry(
        &self,
        context: &TransactionContext,
        state: &mut proto::Ledger,
        request: proto::ArchiveRequest,
    ) -> Result<TransactionExecution<proto::ArchiveResult>, tonic::Status> {
        // Serial, handler-awaited admission of two distinct map actors. Do not
        // reenter the same map or escape/spawn any of these sessions/futures.
        let source = self.map.in_transaction(context).await?;
        let value = source
            .get(reboot::sorted_map_proto::GetRequest {
                key: request.key.clone(),
            })
            .await?
            .value;
        let Some(value) = value else {
            return Err(archive_rejection(request.key, "source entry is absent"));
        };
        let destination = self.archive.in_transaction(context).await?;
        if destination
            .get(reboot::sorted_map_proto::GetRequest {
                key: request.key.clone(),
            })
            .await?
            .value
            .is_some()
        {
            return Err(archive_rejection(
                request.key,
                "archive entry already exists",
            ));
        }
        // Some(empty) is an existing value, not a missing entry.
        source
            .remove(reboot::sorted_map_proto::RemoveRequest {
                keys: vec![request.key.clone()],
            })
            .await?;
        destination
            .insert(reboot::sorted_map_proto::InsertRequest {
                entries: [(request.key.clone(), value.clone())].into(),
            })
            .await?;
        if source
            .get(reboot::sorted_map_proto::GetRequest {
                key: request.key.clone(),
            })
            .await?
            .value
            .is_some()
            || destination
                .get(reboot::sorted_map_proto::GetRequest {
                    key: request.key.clone(),
                })
                .await?
                .value
                != Some(value.clone())
        {
            return Err(tonic::Status::data_loss(
                "archive read-own-writes did not preserve exact presence/value",
            ));
        }
        increment_archive_count(state).map_err(|error| *error)?;
        if request.invalid_range {
            // A caught map failure after touching BOTH actors must doom ALL
            // enrolled participants and discard the tentative app increment.
            destination
                .range(reboot::sorted_map_proto::RangeRequest {
                    limit: 0,
                    ..Default::default()
                })
                .await
                .expect_err("invalid archive range accepted");
        }
        Ok(TransactionExecution::new(proto::ArchiveResult {
            key: request.key,
            value,
            archived: state.archived,
        }))
    }
    async fn archive_history(
        &self,
        context: &TransactionContext,
        _: &mut proto::Ledger,
        request: proto::Batch,
    ) -> Result<TransactionExecution<proto::HistoryResult>, tonic::Status> {
        validate_batch(&request.batch, 1)?;
        let session = self.archive.in_transaction(context).await?;
        let range = session
            .range(reboot::sorted_map_proto::RangeRequest {
                start_key: Some(format!("{}:", request.batch)),
                end_key: Some(format!("{};", request.batch)),
                limit: 100,
            })
            .await?;
        Ok(TransactionExecution::new(proto::HistoryResult {
            keys: range.entries.into_iter().map(|entry| entry.key).collect(),
        }))
    }
    async fn history(
        &self,
        context: &TransactionContext,
        _: &mut proto::Ledger,
        request: proto::Batch,
    ) -> Result<TransactionExecution<proto::HistoryResult>, tonic::Status> {
        validate_batch(&request.batch, 1)?;
        let guard = self.map.in_transaction(context).await?;
        let range = guard
            .range(reboot::sorted_map_proto::RangeRequest {
                start_key: Some(format!("{}:", request.batch)),
                end_key: Some(format!("{};", request.batch)),
                limit: 100,
            })
            .await?;
        Ok(TransactionExecution::new(proto::HistoryResult {
            keys: range.entries.into_iter().map(|entry| entry.key).collect(),
        }))
    }
}
#[cfg(test)]
mod tests {
    use super::*;
    #[test]
    fn archive_rejection_preserves_method_declared_payload() {
        use prost::Message;
        let status = archive_rejection("entry".into(), "source entry is absent");
        let rich = reboot::declared_error_details(&status).unwrap().unwrap();
        assert_eq!(status.code(), tonic::Code::Unknown);
        assert_eq!(rich.details.len(), 1);
        assert_eq!(
            rich.details[0].type_url,
            "type.googleapis.com/{{ name }}.v1.ArchiveRejected"
        );
        let rejected = proto::ArchiveRejected::decode(rich.details[0].value.as_slice()).unwrap();
        assert_eq!(rejected.key, "entry");
        assert_eq!(rejected.reason, "source entry is absent");
    }
    #[test]
    fn archive_count_is_checked_without_partial_increment() {
        let mut state = proto::Ledger {
            archived: 4,
            ..Default::default()
        };
        increment_archive_count(&mut state).unwrap();
        assert_eq!(state.archived, 5);
        state.archived = u64::MAX;
        let before = state.clone();
        assert_eq!(
            increment_archive_count(&mut state).unwrap_err().code(),
            tonic::Code::ResourceExhausted
        );
        assert_eq!(state, before);
    }
    #[tokio::test]
    async fn public_checkpoint_cannot_mint_rejection_or_progress() {
        use generated::LedgerWorkMethodsDatabaseHandler;
        let original = proto::Ledger {
            batch: "batch".into(),
            count: 2,
            approved: 1,
            ..Default::default()
        };
        for reject in [false, true] {
            let mut state = original.clone();
            let error = Ledger
                .checkpoint_scheduled(
                    &mut state,
                    proto::Step {
                        batch: "batch".into(),
                        index: 0,
                        reject,
                    },
                    reference().unwrap(),
                )
                .await
                .err()
                .unwrap();
            assert_eq!(error.code(), tonic::Code::PermissionDenied);
            assert_eq!(state, original);
        }
    }
    #[tokio::test]
    async fn rejected_checkpoint_preserves_progress_and_allows_next_batch() {
        use generated::LedgerWorkMethodsDatabaseHandler;
        let mut state = proto::Ledger {
            batch: "batch".into(),
            count: 2,
            approved: 1,
            ..Default::default()
        };
        Ledger
            .checkpoint(
                &mut state,
                proto::Step {
                    batch: "batch".into(),
                    index: 0,
                    reject: true,
                },
            )
            .await
            .unwrap();
        assert!(state.rejected);
        assert_eq!(state.completed, 1);
        assert!(
            Ledger
                .checkpoint(
                    &mut state,
                    proto::Step {
                        batch: "batch".into(),
                        index: 1,
                        reject: false
                    }
                )
                .await
                .is_err()
        );
        let result = Ledger
            .submit_batch_scheduled(
                &mut state,
                proto::Submit {
                    batch: "next".into(),
                    count: 1,
                    ..Default::default()
                },
                reference().unwrap(),
            )
            .await
            .unwrap();
        assert_eq!(result.task_upserts.len(), 1);
        assert_eq!(state.batch, "next");
        assert!(!state.rejected);
    }
    #[test]
    fn bounded_batch_identity() {
        assert!(validate_batch("batch-001", 3).is_ok());
        for s in ["", "a/b", "a:b", "é"] {
            assert!(validate_batch(s, 3).is_err());
        }
        assert!(validate_batch("batch", 101).is_err());
    }
    #[tokio::test]
    async fn checkpoint_requires_approval() {
        use generated::LedgerWorkMethodsDatabaseHandler;
        let mut state = proto::Ledger {
            batch: "batch".into(),
            count: 2,
            ..Default::default()
        };
        let step = proto::Step {
            batch: "batch".into(),
            index: 0,
            reject: false,
        };
        assert!(Ledger.checkpoint(&mut state, step.clone()).await.is_err());
        assert_eq!(state.completed, 0);
        state.approved = 1;
        assert_eq!(
            Ledger
                .checkpoint(&mut state, step.clone())
                .await
                .unwrap()
                .completed,
            1
        );
        assert!(Ledger.checkpoint(&mut state, step).await.is_err());
    }
}
