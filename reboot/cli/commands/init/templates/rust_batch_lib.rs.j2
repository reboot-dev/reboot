fn archive_rejection(key: String, reason: &str) -> tonic::Status {
    // Preserve the existing Status handler contract; the generated typed
    // transaction-result hook validates this method-scoped declared envelope.
    reboot::declared_error_status(
        tonic::Code::Unknown,
        reason,
        "type.googleapis.com/{{ name }}.v1.ArchiveRejected",
        &proto::ArchiveRejected {
            key,
            reason: reason.into(),
        },
    )
}
fn increment_archive_count(state: &mut proto::Ledger) -> Result<(), Box<tonic::Status>> {
    state.archived = state
        .archived
        .checked_add(1)
        .ok_or_else(|| Box::new(tonic::Status::resource_exhausted("archive count overflow")))?;
    Ok(())
