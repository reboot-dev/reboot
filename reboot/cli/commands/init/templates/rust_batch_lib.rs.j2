impl generated::LedgerViewMethodsDatabaseHandler for Ledger {
    async fn snapshot(
        &self,
        state: &proto::Ledger,
        _: proto::Empty,
    ) -> Result<proto::Ledger, tonic::Status> {
        Ok(state.clone())
    }
}
pub struct Index {
    pub map: generated_map::SortedMap,
}
#[tonic::async_trait]
impl generated::LedgerIndexMethodsTransactionHandler for Index {
    async fn approve(
        &self,
        context: &TransactionContext,
        state: &mut proto::Ledger,
        request: proto::Approval,
    ) -> Result<TransactionExecution<proto::Ledger>, tonic::Status> {
        if state.rejected
            || state.batch != request.batch
            || request.index != state.approved
            || request.index >= state.count
        {
            return Err(tonic::Status::invalid_argument(
                "approval must be the next active batch index",
            ));
        }
        let guard = self.map.in_transaction(context).await?;
        guard
            .insert(reboot::sorted_map_proto::InsertRequest {
                entries: [(format!("{}:{:04}", request.batch, request.index), vec![])].into(),
            })
            .await?;
        state.approved += 1;
        if request.invalid_range {
            // Catch deliberately: the nested failure must still doom the whole root.
            guard
                .range(reboot::sorted_map_proto::RangeRequest {
                    limit: 0,
                    ..Default::default()
                })
                .await
                .expect_err("invalid range accepted");
        }
        Ok(TransactionExecution::new(state.clone()))
    }
    async fn history(
        &self,
        context: &TransactionContext,
        _: &mut proto::Ledger,
        request: proto::Batch,
    ) -> Result<TransactionExecution<proto::HistoryResult>, tonic::Status> {
        validate_batch(&request.batch, 1)?;
        let guard = self.map.in_transaction(context).await?;
        let range = guard
            .range(reboot::sorted_map_proto::RangeRequest {
                start_key: Some(format!("{}:", request.batch)),
                end_key: Some(format!("{};", request.batch)),
                limit: 100,
            })
            .await?;
        Ok(TransactionExecution::new(proto::HistoryResult {
            keys: range.entries.into_iter().map(|entry| entry.key).collect(),
        }))
    }
}
#[cfg(test)]
mod tests {
    use super::*;
    #[tokio::test]
    async fn public_checkpoint_cannot_mint_rejection_or_progress() {
        use generated::LedgerWorkMethodsDatabaseHandler;
        let original = proto::Ledger {
            batch: "batch".into(),
            count: 2,
            approved: 1,
            ..Default::default()
        };
        for reject in [false, true] {
            let mut state = original.clone();
            let error = Ledger
                .checkpoint_scheduled(
                    &mut state,
                    proto::Step {
                        batch: "batch".into(),
                        index: 0,
                        reject,
                    },
                    reference().unwrap(),
                )
                .await
                .err()
                .unwrap();
            assert_eq!(error.code(), tonic::Code::PermissionDenied);
            assert_eq!(state, original);
        }
    }
    #[tokio::test]
    async fn rejected_checkpoint_preserves_progress_and_allows_next_batch() {
        use generated::LedgerWorkMethodsDatabaseHandler;
        let mut state = proto::Ledger {
            batch: "batch".into(),
            count: 2,
            approved: 1,
            ..Default::default()
        };
        Ledger
            .checkpoint(
                &mut state,
                proto::Step {
                    batch: "batch".into(),
                    index: 0,
                    reject: true,
                },
            )
            .await
            .unwrap();
        assert!(state.rejected);
        assert_eq!(state.completed, 1);
        assert!(
            Ledger
                .checkpoint(
                    &mut state,
                    proto::Step {
                        batch: "batch".into(),
                        index: 1,
                        reject: false
                    }
                )
                .await
                .is_err()
        );
        let result = Ledger
            .submit_batch_scheduled(
                &mut state,
                proto::Submit {
                    batch: "next".into(),
                    count: 1,
                    ..Default::default()
                },
                reference().unwrap(),
            )
            .await
            .unwrap();
        assert_eq!(result.task_upserts.len(), 1);
        assert_eq!(state.batch, "next");
        assert!(!state.rejected);
    }
    #[test]
    fn bounded_batch_identity() {
        assert!(validate_batch("batch-001", 3).is_ok());
        for s in ["", "a/b", "a:b", "é"] {
            assert!(validate_batch(s, 3).is_err());
        }
        assert!(validate_batch("batch", 101).is_err());
    }
    #[tokio::test]
    async fn checkpoint_requires_approval() {
        use generated::LedgerWorkMethodsDatabaseHandler;
        let mut state = proto::Ledger {
            batch: "batch".into(),
            count: 2,
            ..Default::default()
        };
        let step = proto::Step {
            batch: "batch".into(),
            index: 0,
            reject: false,
        };
        assert!(Ledger.checkpoint(&mut state, step.clone()).await.is_err());
        assert_eq!(state.completed, 0);
        state.approved = 1;
        assert_eq!(
            Ledger
                .checkpoint(&mut state, step.clone())
                .await
                .unwrap()
                .completed,
            1
        );
        assert!(Ledger.checkpoint(&mut state, step).await.is_err());
    }
}
