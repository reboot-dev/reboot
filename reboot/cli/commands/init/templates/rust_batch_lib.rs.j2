                        reject: false
                    }
                )
                .await
                .is_err()
        );
        let result = Ledger
            .submit_batch_scheduled(
                &mut state,
                proto::Submit {
                    batch: "next".into(),
                    count: 1,
                    ..Default::default()
                },
                reference().unwrap(),
            )
            .await
            .unwrap();
        assert_eq!(result.task_upserts.len(), 1);
        assert_eq!(state.batch, "next");
        assert!(!state.rejected);
    }
    #[test]
    fn default_control_fields_preserve_legacy_wire_encoding() {
        use prost::Message;
        #[derive(Clone, PartialEq, prost::Message)]
        struct LegacySubmit {
            #[prost(string, tag = "1")]
            batch: String,
            #[prost(uint32, tag = "2")]
            count: u32,
            #[prost(int64, tag = "3")]
            not_before: i64,
            #[prost(uint32, tag = "4")]
            reject_after: u32,
            #[prost(bool, tag = "5")]
            reject_step: bool,
        }
        #[derive(Clone, PartialEq, prost::Message)]
        struct LegacyLedger {
            #[prost(string, tag = "1")]
            batch: String,
            #[prost(uint32, tag = "2")]
            count: u32,
            #[prost(uint32, tag = "3")]
            approved: u32,
            #[prost(uint32, tag = "4")]
            completed: u32,
            #[prost(uint64, tag = "5")]
            submissions: u64,
            #[prost(bool, tag = "6")]
            rejected: bool,
            #[prost(uint64, tag = "7")]
            archived: u64,
        }
        let current = proto::Submit {
            batch: "compat".into(),
            count: 3,
            reject_step: true,
            ..Default::default()
        };
        let legacy = LegacySubmit {
            batch: current.batch.clone(),
            count: current.count,
            not_before: current.not_before,
            reject_after: current.reject_after,
            reject_step: current.reject_step,
        };
        assert_eq!(current.encode_to_vec(), legacy.encode_to_vec());
        let current = proto::Ledger {
            batch: "compat".into(),
            count: 3,
            approved: 2,
            completed: 1,
            submissions: 7,
            archived: 5,
            ..Default::default()
        };
        let legacy = LegacyLedger {
            batch: current.batch.clone(),
            count: current.count,
            approved: current.approved,
            completed: current.completed,
            submissions: current.submissions,
            rejected: current.rejected,
            archived: current.archived,
        };
        assert_eq!(current.encode_to_vec(), legacy.encode_to_vec());
    }

    #[tokio::test]
    async fn cooperative_stop_is_opt_in_and_identity_bound() {
        use generated::LedgerWorkMethodsDatabaseHandler;
        let mut state = proto::Ledger {
            batch: "batch".into(),
            count: 3,
            approved: 1,
            completed: 1,
            ..Default::default()
        };
        let before = state.clone();
        assert!(matches!(
            Ledger
                .stop_batch(
                    &mut state,
                    proto::StopRequest {
                        batch: "batch".into(),
                        task_id: vec![1; 16]
                    }
                )
                .await
                .unwrap_err(),
            generated::LedgerWorkMethodsStopBatchError::StopDenied(_)
        ));
        assert_eq!(state, before);
        let before = state.clone();
        let error = Ledger
            .submit_batch_scheduled(
                &mut state,
                proto::Submit {
                    batch: "future".into(),
                    count: 1,
                    stop_enabled: true,
                    not_before: 1,
                    ..Default::default()
                },
                reference().unwrap(),
            )
            .await
            .err()
            .unwrap();
        assert_eq!(error.code(), tonic::Code::InvalidArgument);
        assert_eq!(state, before);
        state.stop_enabled = true;
        state.workflow_id = vec![1; 16];
        let before = state.clone();
        assert!(
            Ledger
                .stop_batch(
                    &mut state,
                    proto::StopRequest {
                        batch: "batch".into(),
                        task_id: vec![2; 16],
                    }
                )
                .await
                .is_err()
        );
        assert_eq!(state, before);
        assert!(
            Ledger
                .stop_batch(
                    &mut state,
                    proto::StopRequest {
                        batch: "other".into(),
                        task_id: vec![1; 16]
                    }
                )
                .await
                .is_err()
        );
        assert_eq!(state, before);
        let reply = Ledger
            .stop_batch(
                &mut state,
                proto::StopRequest {
                    batch: "batch".into(),
                    task_id: vec![1; 16],
                },
            )
            .await
            .unwrap();
        assert!(reply.stop_requested && !reply.stopped);
        assert_eq!((reply.approved, reply.completed, reply.count), (1, 1, 3));
        let repeated = Ledger
            .stop_batch(
                &mut state,
                proto::StopRequest {
                    batch: "batch".into(),
                    task_id: vec![1; 16],
                },
            )
            .await
            .unwrap();
        assert_eq!(reply, repeated);
        state.completed = 3;
        let before = state.clone();
        assert!(
            Ledger
                .stop_batch(
                    &mut state,
                    proto::StopRequest {
                        batch: "batch".into(),
                        task_id: vec![1; 16]
                    }
                )
                .await
                .is_err()
        );
        assert_eq!(state, before);
    }
    #[tokio::test]
    async fn stopped_completion_is_private_preserves_progress_and_resets_on_submit() {
        use generated::LedgerWorkMethodsDatabaseHandler;
        let mut state = proto::Ledger {
            batch: "batch".into(),
            count: 3,
            approved: 1,
            completed: 1,
            stop_enabled: true,
            stop_requested: true,
            ..Default::default()
        };
        let before = state.clone();
        let step = proto::Step {
            batch: "batch".into(),
            index: 1,
            reject: false,
        };
        let error = Ledger
            .finish_stopped_scheduled(&mut state, step.clone(), reference().unwrap())
            .await
            .err()
            .unwrap();
        assert_eq!(error.code(), tonic::Code::PermissionDenied);
        assert_eq!(state, before);
        let wrong = proto::Step {
            index: 0,
            ..step.clone()
        };
        assert!(Ledger.finish_stopped(&mut state, wrong).await.is_err());
        assert_eq!(state, before);
        let reply = Ledger.finish_stopped(&mut state, step).await.unwrap();
        assert!(reply.stopped);
        assert_eq!((reply.approved, reply.completed, reply.count), (1, 1, 3));
        let execution = Ledger
            .submit_batch_scheduled(
                &mut state,
                proto::Submit {
                    batch: "next".into(),
                    count: 1,
                    ..Default::default()
                },
                reference().unwrap(),
            )
            .await
            .unwrap();
        assert_eq!(execution.task_upserts.len(), 1);
        assert!(!state.stop_enabled && !state.stop_requested && !state.stopped);
        assert_eq!((state.approved, state.completed, state.count), (0, 0, 1));
    }
    #[test]
    fn bounded_batch_identity() {
        assert!(validate_batch("batch-001", 3).is_ok());
        for s in ["", "a/b", "a:b", "é"] {
            assert!(validate_batch(s, 3).is_err());
        }
        assert!(validate_batch("batch", 101).is_err());
    }
    #[tokio::test]
    async fn checkpoint_requires_approval() {
        use generated::LedgerWorkMethodsDatabaseHandler;
        let mut state = proto::Ledger {
            batch: "batch".into(),
            count: 2,
            ..Default::default()
        };
        let step = proto::Step {
            batch: "batch".into(),
            index: 0,
            reject: false,
        };
        assert!(Ledger.checkpoint(&mut state, step.clone()).await.is_err());
        assert_eq!(state.completed, 0);
        state.approved = 1;
        assert_eq!(
            Ledger
                .checkpoint(&mut state, step.clone())
                .await
                .unwrap()
                .completed,
            1
        );
        assert!(Ledger.checkpoint(&mut state, step).await.is_err());
    }
