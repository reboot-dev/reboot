use reboot::{
    one_shot_tasks::WorkflowContext,
    runtime::{TransactionContext, TransactionExecution},
};
use std::sync::Arc;
pub mod proto {
    tonic::include_proto!("{{ name }}.v1");
}
pub mod generated {
    include!(concat!(env!("OUT_DIR"), "/{{ name }}/v1/batch.reboot.rs"));
}
pub mod generated_map {
    include!(concat!(
        env!("OUT_DIR"),
        "/rbt/std/collections/v1/sorted_map.reboot.rs"
    ));
}
pub mod host;
pub const STATE_TYPE: &str = "{{ name }}.v1.Ledger";
pub fn reference() -> Result<String, Box<dyn std::error::Error>> {
    Ok(reboot::state_ref::StateRef::from_id(STATE_TYPE, "ledger")?.to_string())
}
#[allow(clippy::result_large_err)]
fn validate_batch(batch: &str, count: u32) -> Result<(), tonic::Status> {
    if batch.is_empty()
        || batch.len() > 48
        || !batch
            .bytes()
            .all(|c| c.is_ascii_alphanumeric() || c == b'-')
        || count == 0
        || count > 100
    {
        return Err(tonic::Status::invalid_argument(
            "batch must be bounded ASCII; count must be 1..100",
        ));
    }
    Ok(())
}
/// Append-only handler entries are visible in the normal rbt host log.
fn event(name: &str) {
    eprintln!("batch-ledger-handler {name}");
}
#[derive(Clone)]
pub struct Ledger;
#[tonic::async_trait]
impl generated::LedgerWorkMethodsDatabaseHandler for Ledger {
    async fn create(
        &self,
        _: &mut proto::Ledger,
        _: proto::Empty,
    ) -> Result<proto::Empty, tonic::Status> {
        Ok(proto::Empty {})
    }
    async fn observe(
        &self,
        state: &proto::Ledger,
        _: proto::Empty,
    ) -> Result<proto::Ledger, tonic::Status> {
        Ok(state.clone())
    }
    async fn submit_batch(
        &self,
        _: &mut proto::Ledger,
        _: proto::Submit,
    ) -> Result<proto::Handle, tonic::Status> {
        Err(tonic::Status::failed_precondition(
            "requires generated scheduling writer",
        ))
    }
    async fn submit_batch_scheduled(
        &self,
        state: &mut proto::Ledger,
        request: proto::Submit,
        state_ref: String,
    ) -> Result<TransactionExecution<proto::Handle>, tonic::Status> {
        validate_batch(&request.batch, request.count)?;
        if state.completed < state.count && !state.rejected {
            return Err(tonic::Status::failed_precondition("previous batch pending"));
        }
        if request.reject_after > request.count {
            return Err(tonic::Status::invalid_argument(
                "reject_after exceeds count",
            ));
        }
        let timestamp = (request.not_before != 0).then_some(prost_types::Timestamp {
            seconds: request.not_before,
            nanos: 0,
        });
        let task = generated::LedgerWorkMethodsTasks::run_batch(&state_ref, &request, timestamp);
        let id = task
            .task_id
            .as_ref()
            .ok_or_else(|| tonic::Status::internal("missing generated task identity"))?
            .task_uuid
            .clone();
        state.batch = request.batch;
        state.count = request.count;
        state.approved = 0;
        state.completed = 0;
        state.rejected = false;
        state.submissions += 1;
        let mut execution = TransactionExecution::new(proto::Handle { id });
        execution.task_upserts.push(task);
        Ok(execution)
    }
    async fn checkpoint(
        &self,
        state: &mut proto::Ledger,
        request: proto::Step,
    ) -> Result<proto::Ledger, tonic::Status> {
        if state.rejected
            || state.batch != request.batch
            || state.completed != request.index
            || state.approved <= request.index
        {
            return Err(tonic::Status::failed_precondition(
                "checkpoint identity or approval mismatch",
            ));
        }
        event(&format!("checkpoint-{}-{}", request.batch, request.index));
        state.completed += 1;
        state.rejected = request.reject;
        Ok(state.clone())
    }
    // Ordinary public Checkpoint RPCs use this scheduling hook. Only the private
    // workflow-step binding invokes checkpoint directly with dispatcher authority.
    async fn checkpoint_scheduled(
        &self,
        _: &mut proto::Ledger,
        _: proto::Step,
        _: String,
    ) -> Result<TransactionExecution<proto::Ledger>, tonic::Status> {
        Err(tonic::Status::permission_denied(
            "checkpoint requires private workflow authority",
        ))
    }
    async fn run_batch(
        &self,
        context: &WorkflowContext<'_>,
        request: proto::Submit,
    ) -> Result<proto::Ledger, generated::LedgerWorkMethodsRunBatchError> {
        validate_batch(&request.batch, request.count)?;
        if request.reject_after > request.count {
            return Err(tonic::Status::invalid_argument("reject_after exceeds count").into());
        }
        event(&format!("body-{}", request.batch));
        let mut result = proto::Ledger::default();
        for index in 0..request.count {
            let iteration =
                context.iteration("batch-v1", u64::from(index), u64::from(request.count))?;
            let batch = request.batch.clone();
            generated::LedgerWorkMethodsWorkflowSteps::observe_until(
                &iteration,
                Arc::new(self.clone()),
                "approval",
                "approved-through-index.v1",
                proto::Empty {},
                move |state| state.batch == batch && state.approved > index,
            )
            .await?;
            result = generated::LedgerWorkMethodsWorkflowSteps::checkpoint(
                &iteration,
                Arc::new(self.clone()),
                "complete",
                proto::Step {
                    batch: request.batch.clone(),
                    index,
                    reject: request.reject_after == index + 1,
                },
            )
            .await?;
            if result.rejected {
                return Err(generated::LedgerWorkMethodsRunBatchError::BatchRejected(
                    proto::BatchRejected {
                        batch: request.batch.clone(),
                        completed: result.completed,
                        reason: "rejected after acknowledged checkpoint".into(),
                    },
                ));
            }
        }
        Ok(result)
    }
}
