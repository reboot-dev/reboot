#[cfg(test)]
mod tests {
    use super::*;
    #[test]
    fn archive_rejection_preserves_method_declared_payload() {
        use prost::Message;
        let status = archive_rejection("entry".into(), "source entry is absent");
        let rich = reboot::declared_error_details(&status).unwrap().unwrap();
        assert_eq!(status.code(), tonic::Code::Unknown);
        assert_eq!(rich.details.len(), 1);
        assert_eq!(
            rich.details[0].type_url,
            "type.googleapis.com/{{ name }}.v1.ArchiveRejected"
        );
        let rejected = proto::ArchiveRejected::decode(rich.details[0].value.as_slice()).unwrap();
        assert_eq!(rejected.key, "entry");
        assert_eq!(rejected.reason, "source entry is absent");
    }
    #[test]
    fn archive_count_is_checked_without_partial_increment() {
        let mut state = proto::Ledger {
            archived: 4,
            ..Default::default()
        };
        increment_archive_count(&mut state).unwrap();
        assert_eq!(state.archived, 5);
        state.archived = u64::MAX;
        let before = state.clone();
        assert_eq!(
            increment_archive_count(&mut state).unwrap_err().code(),
            tonic::Code::ResourceExhausted
        );
        assert_eq!(state, before);
    }
    #[tokio::test]
    async fn tentative_writer_returns_exact_declared_rejection() {
        use generated::LedgerWorkMethodsDatabaseHandler;
        let mut state = proto::Ledger {
            batch: "batch".into(),
            count: 2,
            approved: 1,
            ..Default::default()
        };
        let error = Ledger
            .try_checkpoint(
                &mut state,
                proto::Step {
                    batch: "batch".into(),
                    index: 0,
                    reject: true,
                },
            )
            .await
            .unwrap_err();
        match error {
            generated::LedgerWorkMethodsTryCheckpointError::StepRejected(error) => {
                assert_eq!(error.batch, "batch");
                assert_eq!(error.index, 0);
            }
            generated::LedgerWorkMethodsTryCheckpointError::Grpc(error) => {
                panic!("unexpected framework failure {error}")
            }
        }
        // Handler effects are tentative; native Store acceptance proves rollback.
        assert_eq!(state.completed, 1);
        assert!(state.rejected);
    }
