{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reboot dashboard local ACP configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["providers"],
  "properties": {
    "providers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "claude": {"$ref": "#/$defs/command"},
        "codex": {"$ref": "#/$defs/command"}
      }
    }
  },
  "$defs": {
    "command": {
      "type": "array",
      "minItems": 1,
      "prefixItems": [{"type": "string", "pattern": "^/[^\\u0000]*$"}],
      "items": {"type": "string", "minLength": 1, "pattern": "^[^\\u0000]+$"}
    }
  }
}
