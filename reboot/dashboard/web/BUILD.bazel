load("@aspect_rules_esbuild//esbuild:defs.bzl", "esbuild")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
)

ts_project(
    name = "dashboard_ts",
    srcs = [
        "src/callgraph.ts",
        "src/changelog.ts",
        "src/constants.ts",
        "src/feature_files.ts",
        "src/features.ts",
        "src/graph.tsx",
        "src/link_properties_to_data_types.ts",
        "src/main.tsx",
        "src/markdown.ts",
        "src/pane_target.ts",
        "src/recordings.tsx",
        "src/svg.d.ts",
    ],
    declaration = True,
    tsconfig = ":tsconfig",
    # The contract test imports `link_properties_to_data_types.ts`.
    visibility = ["//tests/reboot/dashboard:__pkg__"],
    deps = [
        "//:node_modules/@bufbuild/protobuf",
        "//:node_modules/@reboot-dev/reboot-react",
        "//:node_modules/@reboot-dev/reboot-std",
        "//:node_modules/@reboot-dev/reboot-std-api",
        "//:node_modules/@reboot-dev/reboot-std-react",
        "//:node_modules/@reboot-dev/reboot-web",
        "//:node_modules/@xyflow/react",
        "//:node_modules/elkjs",
        "//:node_modules/react",
        "//:node_modules/react-dom",
        "//:node_modules/react-resizable-panels",
        "//:node_modules/react-router",
        "//:node_modules/uuid",
        "//rbt/dashboard/v1:dashboard_js_reboot_react",
        "//rbt/std/collections/ordered_map/v1:ordered_map_js_reboot_react",
        "//rbt/v1alpha1/api:api_js_proto",
        "//rbt/v1alpha1/api:schema_js_proto",
        "//rbt/v1alpha1/bdd:feature_js_proto",
        "//rbt/v1alpha1/bdd:grammar_js_proto",
    ],
)

# `tsconfig` makes esbuild use the automatic JSX runtime.
esbuild(
    name = "dashboard_bundle",
    srcs = [
        "dashboard.css",
        "src/reboot-logo.svg",
        ":dashboard_ts",
    ],
    bazel_sandbox_plugin = False,
    config = "esbuild.config.mjs",
    # React's production build.
    define = {"process.env.NODE_ENV": "\"production\""},
    entry_point = "src/main.js",
    format = "esm",
    # An MCP host fetches the one-file page over the MCP connection each
    # time it opens it. `minify` also drops the
    # `if (false) { throw new Error("^_^") }` branch `define` leaves in
    # react-dom's `checkDCE`, which React DevTools throws on.
    minify = True,
    output = "dashboard_bundle.js",
    output_css = "dashboard_bundle.css",
    platform = "browser",
    # Nothing serves a source map beside the bundle.
    sourcemap = "",
    tsconfig = "tsconfig.json",
    visibility = [
        "//rbt/dashboard/v1:__pkg__",
        "//reboot/dashboard/backend:__pkg__",
    ],
)

exports_files(
    [
        "favicon.svg",
        "index.html",
    ],
    visibility = [
        "//rbt/dashboard/v1:__pkg__",
        "//reboot/dashboard/backend:__pkg__",
    ],
)
