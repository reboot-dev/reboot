load("@aspect_rules_esbuild//esbuild:defs.bzl", "esbuild")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
)

ts_project(
    name = "dashboard_ts",
    srcs = [
        "src/callgraph.ts",
        "src/changelog.ts",
        "src/constants.ts",
        "src/feature_files.ts",
        "src/features.ts",
        "src/graph.tsx",
        "src/link_properties_to_data_types.ts",
        "src/main.tsx",
        "src/markdown.ts",
        "src/pane_target.ts",
    ],
    declaration = True,
    tsconfig = ":tsconfig",
    # The contract test imports `link_properties_to_data_types.ts`.
    visibility = ["//tests/reboot/dashboard:__pkg__"],
    deps = [
        "//:node_modules/@bufbuild/protobuf",
        "//:node_modules/@reboot-dev/reboot-react",
        "//:node_modules/@reboot-dev/reboot-std",
        "//:node_modules/@reboot-dev/reboot-std-api",
        "//:node_modules/@reboot-dev/reboot-std-react",
        "//:node_modules/@reboot-dev/reboot-web",
        "//:node_modules/@xyflow/react",
        "//:node_modules/elkjs",
        "//:node_modules/react",
        "//:node_modules/react-dom",
        "//:node_modules/react-resizable-panels",
        "//:node_modules/react-router",
        "//:node_modules/uuid",
        "//rbt/dashboard/v1:dashboard_js_reboot_react",
        "//rbt/std/collections/ordered_map/v1:ordered_map_js_reboot_react",
        "//rbt/v1alpha1/api:api_js_proto",
        "//rbt/v1alpha1/api:schema_js_proto",
        "//rbt/v1alpha1/bdd:feature_js_proto",
        "//rbt/v1alpha1/bdd:grammar_js_proto",
    ],
)

# `tsconfig` makes esbuild use the automatic JSX runtime.
esbuild(
    name = "dashboard_bundle",
    srcs = [
        ":dashboard_ts",
    ],
    bazel_sandbox_plugin = False,
    # `minifySyntax` has no attribute on the rule.
    config = "esbuild.config.mjs",
    # `esbuild` defaults `NODE_ENV` to "development" when not
    # minifying; this ships React's production build.
    define = {"process.env.NODE_ENV": "\"production\""},
    entry_point = "src/main.js",
    format = "esm",
    output = "dashboard_bundle.js",
    platform = "browser",
    tsconfig = "tsconfig.json",
    visibility = ["//reboot/dashboard/backend:__pkg__"],
)

# The same bundle minified, for the page built into one file that an
# MCP host is given whole: every byte of it crosses the MCP connection
# each time the page is opened.
esbuild(
    name = "dashboard_bundle_minified",
    srcs = [
        ":dashboard_ts",
    ],
    bazel_sandbox_plugin = False,
    define = {"process.env.NODE_ENV": "\"production\""},
    entry_point = "src/main.js",
    format = "esm",
    minify = True,
    output = "dashboard_bundle_minified.js",
    platform = "browser",
    # The page has no file beside it for a source map to be in.
    sourcemap = "",
    tsconfig = "tsconfig.json",
    visibility = ["//rbt/dashboard/v1:__pkg__"],
)

exports_files(
    [
        "dashboard.css",
        "favicon.svg",
        "index.html",
        "reboot-logo.svg",
    ],
    visibility = [
        "//rbt/dashboard/v1:__pkg__",
        "//reboot/dashboard/backend:__pkg__",
    ],
)
