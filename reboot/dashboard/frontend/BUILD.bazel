load("@aspect_rules_esbuild//esbuild:defs.bzl", "esbuild")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
)

ts_project(
    name = "dashboard_ts",
    srcs = [
        "src/callgraph.ts",
        "src/changelog.ts",
        "src/constants.ts",
        "src/graph.tsx",
        "src/link_fields_to_data_types.ts",
        "src/main.tsx",
    ],
    declaration = True,
    tsconfig = ":tsconfig",
    # The contract test imports `link_fields_to_data_types.ts`.
    visibility = ["//tests/reboot/dashboard:__pkg__"],
    deps = [
        "//:node_modules/@bufbuild/protobuf",
        "//:node_modules/@reboot-dev/reboot-react",
        "//:node_modules/@reboot-dev/reboot-std",
        "//:node_modules/@reboot-dev/reboot-std-api",
        "//:node_modules/@reboot-dev/reboot-std-react",
        "//:node_modules/@reboot-dev/reboot-web",
        "//:node_modules/@xyflow/react",
        "//:node_modules/elkjs",
        "//:node_modules/react",
        "//:node_modules/react-dom",
        "//:node_modules/react-resizable-panels",
        "//:node_modules/react-router",
        "//:node_modules/uuid",
        "//rbt/dashboard/v1:dashboard_js_reboot_react",
        "//rbt/std/collections/ordered_map/v1:ordered_map_js_reboot_react",
        "//rbt/v1alpha1:schema_js_proto",
    ],
)

# `tsconfig` makes esbuild use the automatic JSX runtime.
esbuild(
    name = "dashboard_bundle",
    srcs = [
        ":dashboard_ts",
    ],
    bazel_sandbox_plugin = False,
    # `esbuild` defaults `NODE_ENV` to "development" when not
    # minifying; this ships React's production build.
    define = {"process.env.NODE_ENV": "\"production\""},
    entry_point = "src/main.js",
    format = "esm",
    output = "dashboard_bundle.js",
    platform = "browser",
    tsconfig = "tsconfig.json",
    visibility = ["//reboot/dashboard:__pkg__"],
)

exports_files(
    [
        "dashboard.css",
        "index.html",
        "reboot-logo.svg",
    ],
    visibility = ["//reboot/dashboard:__pkg__"],
)
